# Copy to .env (gitignored) and fill in. Read by deploy/hetzner/remote.sh (just remote-*) and just upload, not loaded
# into your shell: the agents never see the Hetzner or R2 keys.

# Hetzner Cloud: a project's API token (read and write). A project of its own for LEEROY keeps its servers apart.
HCLOUD_TOKEN=

# Cloudflare R2: the account id and an API token's S3 keys (Object Read & Write on both buckets)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_RUNS_BUCKET=leeroy-runs       # private: whole runs, uploaded by the run servers
R2_ASSETS_BUCKET=leeroy-assets   # public: what run pages link to (just upload)

# The agents' keys, copied to each run server. Codex's login is ~/.codex/auth.json (copied as it is); Claude Code's
# macOS login is in the Keychain, so make a long-lived token once with `claude setup-token`.
CLAUDE_CODE_OAUTH_TOKEN=
OPENROUTER_API_KEY=
OPENAI_API_KEY=

# Optional (the defaults in deploy/hetzner/remote.sh)
# LEEROY_LOCATION=hil   # Hillsboro, Oregon (US West); ash: Ashburn, Virginia; fsn1, nbg1, hel1: Europe
# LEEROY_TYPE=ccx33
# LEEROY_IMAGE_TYPE=ccx23
# LEEROY_MAX_HOURS=26
# LEEROY_SSH_KEY=~/.ssh/id_ed25519
