#!/bin/sh
# wow 'return bot.get_level()'        evaluate Lua in the live session, print JSON result
# wow < snippet.lua                   same, from stdin
# wow -f grind.lua                    (re)load a script file, e.g. to replace on_tick
# wow -w 60 'return bot.get_xp()'     wait 60s first (max 600), then evaluate — use this to poll progress
# wow -c 60 'return bot.read_chat()'  same, but returns early as soon as another player messages you
# Session: the azsdk daemon on port $WOW_PORT (default 8090); prints {"result": ...} (+ "script_errors"
# when the running script failed since the last call) or {"error": "..."}.
eval_() {
  jq -n --arg code "$1" '{jsonrpc: "2.0", id: 1, method: "script.eval", params: {code: $code}}' |
    curl -sS "127.0.0.1:${WOW_PORT:-8090}/rpc" --data-binary @- |
    jq -c 'if .error then {error: .error.message} else .result end'
}
if [ "$1" = "-w" ] || [ "$1" = "-c" ]; then
  case "$2" in ''|*[!0-9]*) echo "usage: wow $1 <seconds> <lua>"; exit 1 ;; esac
  t=$(( $2 > 600 ? 600 : $2 ))
  if [ "$1" = "-w" ]; then sleep "$t"; else
    jq -n --argjson t "$t" '{jsonrpc: "2.0", id: 1, method: "wait.chat", params: {timeout_s: $t}}' |
      curl -sS "127.0.0.1:${WOW_PORT:-8090}/rpc" --data-binary @- >/dev/null # long-polls until a message arrives
  fi
  shift 2
fi
if [ "$1" = "-f" ]; then
  code="return dofile(\"$(cd "$(dirname "$2")" && pwd)/$(basename "$2")\")"
elif [ -n "$1" ]; then code="$1"; else code="$(cat)"; fi
out=$(eval_ "$code")
# unread messages from other players (chat, whispers, party, invites) ride along on every reply until read
n=$(eval_ 'return bot.chat_pending()' | jq -r '.result // 0' 2>/dev/null)
if [ "${n:-0}" -gt 0 ] 2>/dev/null; then
  printf '%s\n' "$out" | jq -c --argjson n "$n" --arg hint "$n unread message(s) from other players: wow 'return bot.read_chat()'" \
    '. + {chat_pending: $n, chat: $hint}'
else printf '%s\n' "$out"; fi
