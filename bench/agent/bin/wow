#!/bin/sh
# wow 'return me.level()'              evaluate Lua in the live session (shared with your running scripts), print JSON
# wow < snippet.lua                   same, from stdin
# wow -f grind.lua                    (re)load a script file
# wow status                          one-call snapshot: level, xp, hp, position, state, bags, quests, group, nearby
# wow tasks                           your running script tasks: state, status, what each is waiting for
# wow events [--types chat,quest_*] [--last 50] [--since seq] [--match text]
#                                     the event log (chat, combat, loot, quests, action results, errors, script logs)
# wow wait [--types chat:whisper,death] [--match text] [seconds]
#                                     block until a matching event happens (default: your subscription), max 600s
# wow subscribe [types | +types | -types]
#                                     what wakes you (wow wait) and what replies show in full: show it, replace it,
#                                     or add/remove types. Chat by kind: chat:whisper, chat:npc_*, chat (all)
# wow answer <id> <choice>            answer a script's ask() (an "attention" event)
# wow -w 60 'lua'                     sleep 60s first, then evaluate
# Every eval reply carries "events": what happened since your last call (counts by type, important ones in full).
# Subscribed chat, invites, trades and script questions are also printed to stderr ("wow: chat ..."),
# with the minutes left in the run ("wow: 42 min left").
# Session: the azsdk daemon on port $WOW_PORT (default 8090).
rpc() { # method, params JSON
  jq -n --arg m "$1" --argjson p "$2" '{jsonrpc: "2.0", id: 1, method: $m, params: $p}' |
    curl -sS "127.0.0.1:${WOW_PORT:-8090}/rpc" --data-binary @- |
    jq -c 'if .error then {error: .error.message} else .result end'
}
# messages from other players (and script questions) also go to stderr, so piping the reply through jq can't hide them
eval_() {
  out=$(rpc script.eval "$(jq -n --arg code "$1" '{code: $code}')")
  printf '%s\n' "$out"
  printf '%s\n' "$out" | jq -r '.events.important[]? |
    select(.type == "chat" or .type == "party_invite" or .type == "trade" or .type == "attention") |
    "wow: \(.type) " + (if .type == "chat" then "\(.data.kind) from \(.data.from): \(.data.text)" else (.data | tojson) end)' >&2
  [ -n "$WOWBENCH_BOARD" ] && jq -r '"wow: \(.minutes_left // empty) min left"' "$WOWBENCH_BOARD/$WOWBENCH_CHAR.json" >&2 2>/dev/null
  return 0
}
# --types a,b --last n --since n --match s [seconds] -> query params JSON (seconds -> timeout_s)
params() {
  p='{}'
  while [ $# -gt 0 ]; do
    case "$1" in
      --types) p=$(printf '%s' "$p" | jq -c --arg v "$2" '. + {types: ($v | split(","))}'); shift 2 ;;
      --last|--since|--limit) p=$(printf '%s' "$p" | jq -c --arg k "${1#--}" --argjson v "$2" '. + {($k): $v}'); shift 2 ;;
      --match) p=$(printf '%s' "$p" | jq -c --arg v "$2" '. + {match: $v}'); shift 2 ;;
      *[!0-9]*) echo "unknown option $1" >&2; exit 1 ;;
      *) p=$(printf '%s' "$p" | jq -c --argjson v "$1" '. + {timeout_s: $v}'); shift ;;
    esac
  done
  printf '%s' "$p"
}
# one event per line: {seq, ago_s, type, ...data}
lines() { jq -c 'if type == "array" then .[] else . end | if .seq then {seq, ago_s: ((now * 1000 - .t) / 1000 | floor), type} + (.data // {}) else . end'; }
case "$1" in
  status) eval_ "return me.status()"; exit ;;
  tasks) eval_ "return task.list()"; exit ;;
  answer) eval_ "return answer($2, $(jq -n --arg v "$3" '$v'))"; exit ;;
  events) shift; rpc events.query "$(params "$@")" | lines; exit ;;
  wait) shift
    p=$(params "$@")
    out=$(rpc events.wait "$p")
    printf '%s\n' "$out" | jq -c '{timed_out, seq}'
    printf '%s\n' "$out" | jq -c '.events // []' | lines
    exit ;;
  subscribe)
    case "$2" in
      '') rpc events.subscribe '{}' ;;
      [+-]*) rpc events.subscribe "$(rpc events.subscribe '{}' | jq -c --arg op "$(printf %.1s "$2")" --arg v "${2#?}" \
        '($v | split(",")) as $t | {types: (if $op == "+" then . + ($t - .) else . - $t end)}')" ;;
      *) rpc events.subscribe "$(jq -nc --arg v "$2" '{types: ($v | split(","))}')" ;;
    esac
    exit ;;
  -w) case "$2" in ''|*[!0-9]*) echo "usage: wow -w <seconds> <lua>"; exit 1 ;; esac
    sleep $(( $2 > 600 ? 600 : $2 )); shift 2 ;;
  -c) case "$2" in ''|*[!0-9]*) echo "usage: wow -c <seconds> <lua>"; exit 1 ;; esac # legacy: wait for chat
    rpc events.wait "{\"types\":[\"chat\"],\"timeout_s\":$2}" >/dev/null; shift 2 ;;
esac
if [ "$1" = "-f" ]; then
  code="return dofile(\"$(cd "$(dirname "$2")" && pwd)/$(basename "$2")\")"
elif [ -n "$1" ]; then code="$1"; else code="$(cat)"; fi
eval_ "$code"
