---
// What each agent asked the game to do over the run: a lane per player of SDK calls per interval (failed calls stacked
// on top in the warning colour, each bar's tooltip naming the interval's most frequent failure), with deaths and
// level-ups marked; then each player's most frequent errors. From the sessions' event logs, by azbench publish.
import Figure from './Figure.astro';
import { barInterval, clock, colors, intervalName, timeTicks, type Run, playerTip } from '../lib/results';

interface Props {
  run: Run;
}

const { run } = Astro.props;
const color = colors(run);
const ps = run.players.filter(p => p.trajectory?.length);
const endMin = Math.max(1, ...ps.map(p => p.trajectory!.at(-1)![0] + 1));
const per = barInterval(endMin * 60, 120); // minutes per column
const W = 900, L = 96, R = 8, LANE = 60, GAP = 14, T = 8;
const H = T + ps.length * (LANE + GAP) + 18;
const span = Math.ceil(endMin / per) * per; // the axis, in whole columns
const colW = ((W - L - R) * per) / span;
const x = (min: number) => L + (min / span) * (W - L - R);
const lanes = ps.map((p, i) => {
  const cols = new Map<number, { ok: number; failed: number; why: Map<string, number> }>();
  for (const [m, ok, failed, top, n] of p.trajectory!) {
    const c = Math.floor(m / per);
    const b = cols.get(c) ?? { ok: 0, failed: 0, why: new Map() };
    b.ok += ok;
    b.failed += failed;
    if (top) b.why.set(top, (b.why.get(top) ?? 0) + n);
    cols.set(c, b);
  }
  const levels: { m: number; to: number }[] = [];
  const s = p.series ?? [];
  for (let k = 1; k < s.length; k++) {
    for (let lv = Math.floor(s[k - 1][1]) + 1; lv <= Math.floor(s[k][1]); lv++) levels.push({ m: s[k][0] / 60, to: lv });
  }
  return { p, y0: T + i * (LANE + GAP), cols: [...cols.entries()], levels };
});
// scaled to the 95th percentile, so a burst doesn't flatten the rest (taller bars are clipped)
const sizes = lanes.flatMap(l => l.cols.map(([, b]) => b.ok + b.failed)).sort((a, b) => a - b);
const top = Math.max(1, sizes[Math.floor(sizes.length * 0.95)] ?? 1);
const errs = run.players.filter(p => p.failures?.length);
---

<div class="space-y-4">
  {ps.length > 0 && (
    <Figure
      title="Calls to the game"
      note={`SDK calls per ${intervalName(per)}, failed calls in amber on top. Ticks above a lane are level-ups, crosses deaths.`}
    >
      <svg viewBox={`0 0 ${W} ${H}`} class="w-full" role="img" aria-label="Each player's SDK calls over the run">
        {lanes.map(({ p, y0, cols, levels }) => {
          const base = y0 + LANE;
          const h = (n: number) => Math.min(1, n / top) * (LANE - 10);
          return (
            <g>
              <text x={L - 10} y={base - LANE / 2 + 4} text-anchor="end" class:list={['font-mono text-[11px]', color[p.char]]} fill="currentColor"><title>{playerTip(p)}</title>{p.char}</text>
              <line x1={L} x2={W - R} y1={base} y2={base} stroke="var(--color-hairline)" />
              {cols.map(([c, b]) => {
                const top1 = [...b.why.entries()].sort((a, z) => z[1] - a[1])[0];
                const tip = `${p.char}, ${clock(c * per)}–${clock((c + 1) * per)}\n${(b.ok + b.failed).toLocaleString('en')} calls, ${b.failed.toLocaleString('en')} failed${top1 ? `\nmost often: ${top1[0]} ×${top1[1]}` : ''}`;
                const bx = L + c * colW;
                return (
                  <g>
                    <title>{tip}</title>
                    <rect x={bx} y={y0} width={colW} height={LANE} fill="transparent" />
                    <rect x={bx + 0.5} y={base - h(b.ok)} width={Math.max(1, colW - 1)} height={h(b.ok)} class="fill-muted/45" />
                    {b.failed > 0 && <rect x={bx + 0.5} y={base - h(b.ok) - h(b.failed)} width={Math.max(1, colW - 1)} height={Math.max(1, Math.min(h(b.failed), LANE - 10 - h(b.ok)))} class="fill-warning" />}
                  </g>
                );
              })}
              {levels.map(l => (
                <g>
                  <title>{`${p.char} reached level ${l.to} at ${clock(Math.round(l.m))}`}</title>
                  <line x1={x(l.m)} x2={x(l.m)} y1={y0 - 2} y2={y0 + 4} stroke="currentColor" class={color[p.char]} />
                </g>
              ))}
              {(p.deaths_at ?? []).map(t => (
                <text x={x(t / 60)} y={y0 + 6} text-anchor="middle" class="fill-error font-mono text-[11px]"><title>{`${p.char} died at ${clock(Math.round(t / 60))}`}</title>✕</text>
              ))}
            </g>
          );
        })}
        {timeTicks(span * 60).map(t => (
          <text x={x(t.s / 60)} y={H - 4} text-anchor="middle" class="fill-faint font-mono text-[11px]">{t.label}</text>
        ))}
      </svg>
    </Figure>
  )}

  {errs.length > 0 && (
    <Figure title="Most frequent errors" note="Each player's most common failed SDK calls over the run, as operation and error code, with counts.">
      <ul class="grid grid-cols-1 gap-x-8 gap-y-4 sm:grid-cols-2 lg:grid-cols-3">
        {errs.map(p => (
          <li class="text-xs">
            <span class={color[p.char]} title={playerTip(p)}>{p.char}</span>
            <ul class="mt-1 space-y-0.5 font-mono text-[11px]">
              {p.failures!.map(f => (
                <li class="flex justify-between gap-3">
                  <span class="truncate text-muted">{f.op} <span class="text-warning">{f.code}</span></span>
                  <span class="text-faint">{f.count.toLocaleString('en')}</span>
                </li>
              ))}
            </ul>
          </li>
        ))}
      </ul>
    </Figure>
  )}
</div>
