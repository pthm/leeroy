---
// How each player's time went, twice: the character (fighting, travelling, idle, dead, from the recordings) and the
// agent (thinking, a script running while it waits, in a call, or nothing running, from the harness).
import Figure from './Figure.astro';
import { colors, type Run, playerTip } from '../lib/results';

interface Props {
  run: Run;
}

const { run } = Astro.props;
const color = colors(run);
const game = [
  { k: 'fighting_pct', label: 'fighting', c: 'var(--color-error)' },
  { k: 'travelling_pct', label: 'travelling', c: 'var(--color-info)' },
  { k: 'idle_pct', label: 'idle', c: 'var(--color-outline)' },
  { k: 'dead_pct', label: 'dead', c: 'var(--color-faint)' },
] as const;
const agent = [
  { k: 'thinking', label: 'thinking', c: 'var(--color-accent)' },
  { k: 'waiting', label: 'script running', c: 'var(--color-success)' },
  { k: 'in_call', label: 'in a call', c: 'var(--color-info)' },
  { k: 'no_script', label: 'nothing running', c: 'var(--color-outline)' },
] as const;
const ps = run.players.filter(p => p.time_use || p.time_pct_by_state);
// beside each bar: time with the group and with a broken weapon (they overlap the bar's parts), the model's median
// time thinking per call
const characterNote = (p: (typeof ps)[number]) => {
  const u = p.time_use;
  if (!u) return '';
  return [run.players.length > 1 && `${u.with_group_pct}% grouped`, p.pet_pct != null && `pet ${p.pet_pct}%`, u.broken_weapon_pct ? `${u.broken_weapon_pct}% broken` : ''].filter(Boolean).join(' · ');
};
const agentNote = (p: (typeof ps)[number]) => (p.think_median_s != null ? `${p.think_median_s < 1 ? '<1' : p.think_median_s} s per think` : '');
---

{ps.length > 0 && (
  <div class="grid grid-cols-1 gap-4 md:grid-cols-2">
    {[
      { title: 'Character', caption: 'From the game log: fighting is in combat, dead is a corpse or ghost. Grouped (within 50 yd of a party member), pet and broken weapon overlap the bar.', parts: game, get: (p: (typeof ps)[number], k: string) => (p.time_use as any)?.[k] ?? 0, note: characterNote },
      { title: 'Agent', caption: 'From the harness: thinking is the model generating, script running is waiting on its Lua, in a call is a tool command running. Per think: median time before each call.', parts: agent, get: (p: (typeof ps)[number], k: string) => p.time_pct_by_state?.[k] ?? 0, note: agentNote },
    ].map(({ title, caption, parts, get, note }) => (
      <Figure title={title} note={caption}>
        <Fragment slot="legend">
          {parts.map(part => <span><span style={`color:${part.c}`}>■</span> {part.label}</span>)}
        </Fragment>
        <ul class="space-y-2">
          {ps.map(p => (
            <li class="grid grid-cols-[6rem_1fr_7.5rem] items-center gap-3 text-xs">
              <span class:list={['truncate', color[p.char]]} title={playerTip(p)}>{p.char}</span>
              <span class="flex h-3 overflow-hidden rounded-sm bg-elevated">
                {parts.map(part => {
                  const v = get(p, part.k);
                  return v > 0 && <span style={`width:${v}%;background:${part.c}`} title={`${part.label}: ${Math.round(v)}%`} />;
                })}
              </span>
              <span class="truncate text-right font-mono text-[11px] text-faint" title={note(p)}>{note(p)}</span>
            </li>
          ))}
        </ul>
      </Figure>
    ))}
  </div>
)}
