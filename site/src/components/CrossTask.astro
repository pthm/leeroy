---
// Every entry (a model at an effort) across every task: each cell its result there (goals met and mean time, or XP
// per hour) and n, shaded by where it ranks in that task. Blank: not run. Sortable by any column (scripts/interact.ts).
import { view } from '../lib/kinds';
import { LABS, latestFor, displayNames, entryName, harnessName, leaderboard, percentiles, taskShort, taskTitle, tasks, type ModelRow } from '../lib/results';
import { resultsUrl } from '../lib/url';
import Figure from './Figure.astro';
import FilterBar from './FilterBar.astro';

interface Props {
  version?: string;
}

const { version = 'all' } = Astro.props;
const ts = tasks(version);
const by = new Map<string, { row: ModelRow; cells: Map<string, ModelRow>; pct: Map<string, number> }>();
for (const t of ts) {
  const pct = percentiles(t, version);
  for (const row of leaderboard(t, version)) {
    const e = by.get(row.key) ?? { row, cells: new Map(), pct: new Map() };
    e.cells.set(t, row);
    e.pct.set(t, pct.get(row.key)!);
    by.set(row.key, e);
  }
}
const best = new Map(ts.map(t => [t, leaderboard(t, version)[0]?.key]));
const entries = [...by.values()]
  .map(e => ({ ...e, mean: [...e.pct.values()].reduce((a, b) => a + b, 0) / e.pct.size }))
  .sort((a, b) => b.pct.size - a.pct.size || b.mean - a.mean);
const names = displayNames(entries.map(e => e.row));
// each task's cell as its goal kind reads it (kinds.ts)
const cellText = (t: string, r: ModelRow) => view(t, version).cell(r);
const cellSub = (t: string, r: ModelRow) => view(t, version).sub(r);
const cellValue = (t: string, r: ModelRow) => view(t, version).value(r);
---

<div data-filtered>
<FilterBar rows={entries.map(e => e.row)} />
<Figure
  pad={false}
  note="Each cell is the entry's result in that task and its attempts, shaded by its percentile there; bold marks the task's best. Avg pct. is the mean percentile over the tasks run, not an overall score."
>
  <table class="data cross" data-sortable>
    <thead>
      <tr>
        <th data-sort="text">Model</th>
        <th data-sort="text">Harness</th>
        {ts.map(t => (
          <th class="num" data-sort="num" title={taskTitle(t)}>
            <a href={resultsUrl(version, t, latestFor(t))} class="whitespace-nowrap hover:text-accent">{taskShort(t)}</a>
            <span class="block text-[9px] tracking-normal text-faint normal-case">{view(t, version).unit}</span>
          </th>
        ))}
        <th class="num" data-sort="num" title="Tasks this entry has run">Tasks</th>
        <th class="num whitespace-nowrap" data-sort="num" title="Mean of its per-task percentiles, over the tasks it has run">Avg pct.</th>
      </tr>
    </thead>
    <tbody>
      {entries.map(e => (
        <tr data-key={e.row.key} data-lab={e.row.lab}>
          <td class="whitespace-nowrap text-fg" data-v={names.get(e.row.key)}>
            <span style={`color:${LABS[e.row.lab]}`} title={e.row.lab}>●</span> {entryName(e.row)}
          </td>
          <td class="whitespace-nowrap text-muted" data-v={e.row.runtime}>{harnessName(e.row.runtime)}</td>
          {ts.map(t => {
            const r = e.cells.get(t);
            const p = e.pct.get(t) ?? 0;
            return r ? (
              <td
                class:list={['num cell', best.get(t) === r.key && 'font-semibold text-fg']}
                style={`background:color-mix(in oklab, var(--color-accent) ${Math.round(p * 38)}%, transparent)`}
                data-v={cellValue(t, r)}
                title={`${entryName(r)} in ${taskTitle(t)}: ${cellText(t, r)} (${cellSub(t, r)}); ranks ${Math.round(p * 100)}th percentile`}
              >
                <span class="block">{cellText(t, r)}</span>
                <span class="block text-[10px] text-fg/75">{cellSub(t, r)}</span>
              </td>
            ) : (
              <td class="num text-faint" data-v="-1e12">·</td>
            );
          })}
          <td class="num text-muted" data-v={e.pct.size}>{e.pct.size}</td>
          <td class="num text-fg" data-v={e.mean}>{Math.round(e.mean * 100)}</td>
        </tr>
      ))}
    </tbody>
  </table>
</Figure>
</div>
