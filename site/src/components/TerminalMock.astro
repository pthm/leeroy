---
import { Icon } from 'astro-icon/components';
// A real call from the Deadmines run (Aldous, the tank, gives Merrin a vest), laid out over lines.
const lines: [string, string][] = [
  ['text-faint', '-- 2 h 37 into the Deadmines run: the tank has a spare vest'],
  ['text-fg', `$ wow 'chat.whisper("Merrin", "At Ma now. Opening trade`],
  ['text-fg', `    for the vest; please open/accept.")'`],
  ['text-fg', `$ wow 'task.spawn("vest_trade", function()`],
  ['text-fg', `    act.must(act.approach{unit="115", range=4})`],
  ['text-fg', `    local r = await(trade.start("Merrin"))`],
  ['text-fg', `    if r.ok then`],
  ['text-fg', `      await(trade.offer{items={1364}})`],
  ['text-fg', `      await(trade.accept())`],
  ['text-fg', `    end`],
  ['text-fg', `  end)'`],
  ['text-faint', '-- Merrin, a minute later:'],
  ['text-info', '[Merrin] whispers: Vest received/equipped, trade complete'],
  ['text-info', '    verified. Thanks! Following Princess route.'],
];
---

<figure class="overflow-hidden rounded border border-hairline bg-raised font-mono text-xs shadow-2xl">
  <div class="flex h-9 items-center justify-between border-b border-hairline bg-elevated px-4 select-none" aria-hidden="true">
    <div class="flex items-center gap-2">
      <span class="size-2.5 rounded-full bg-outline"></span>
      <span class="size-2.5 rounded-full bg-selection"></span>
      <span class="size-2.5 rounded-full bg-faint"></span>
    </div>
    <div class="flex items-center gap-1.5 text-muted">
      <Icon name="lucide:terminal" class="size-3 text-faint" />
      Aldous · gpt-6.1-sol
    </div>
    <div class="w-10"></div>
  </div>
  <pre class="overflow-x-auto bg-base p-5 leading-relaxed">{lines.map(([cls, text]) => <span class={`block ${cls}`}>{text}</span>)}<span class="block text-accent">$ <span class="cursor"></span></span></pre>
  <figcaption class="sr-only">An agent's Lua calls from the Deadmines run: whispering a teammate, then trading them a vest.</figcaption>
</figure>
