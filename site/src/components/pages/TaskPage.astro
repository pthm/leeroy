---
import CostChart from '../CostChart.astro';
import Leaderboard from '../Leaderboard.astro';
import ModelInsights from '../ModelInsights.astro';
import RouteMap from '../RouteMap.astro';
import Section from '../Section.astro';
import SectionHeader from '../SectionHeader.astro';
import Layout from '../../layouts/Layout.astro';
import { Icon } from 'astro-icon/components';
import { TASKS, latestFor, versionLabel, dollars, duration, harnessName, isProgress, leaderboard, modelName, outcome, bestRate, effortOf, entryKey, entryName, meanRate, rate, runDate, runsOf, specLabel, taskTitle, tasks, totals, xpRate, type MapBox } from '../../lib/results';
import { url } from '../../lib/url';

import VersionPicker from '../VersionPicker.astro';

// A task's results at one benchmark version (or 'all'): pages/results/[task] and pages/results/v/[version]/[task].
interface Props {
  task: string;
  version: string;
}

const { task, version } = Astro.props;
const info = TASKS[task];
const runs = runsOf(task, version).toReversed();
const all = runs.flatMap(r => r.players);
// one map per map the runs crossed: the widest run's box (its backdrop), every attempt over it in its model's colour
const entries = leaderboard(task, version);
const modelCls = (key: string) => `pc-${entries.findIndex(e => e.key === key) % 8}`;
const boxes = new Map<number, MapBox>();
for (const r of runs)
  for (const b of r.maps ?? []) {
    const have = boxes.get(b.map);
    if (!have || (b.x_max - b.x_min) * (b.y_max - b.y_min) > (have.x_max - have.x_min) * (have.y_max - have.y_min)) boxes.set(b.map, b);
  }
const attempts = runs.flatMap(r =>
  r.players.map(p => ({ key: entryKey(p), name: `${entryName({ model: p.model, effort: effortOf(p) })} · ${p.char} · ${runDate(r)}`, cls: modelCls(entryKey(p)), track: p.track ?? [], deaths: p.death_list ?? [] })),
);
const tiles = [
  { v: String(runs.length), k: runs.length === 1 ? 'run' : 'runs' },
  { v: String(new Set(all.map(p => p.model)).size), k: 'models' },
  { v: String(all.length), k: 'attempts' },
  isProgress(task)
    ? { v: rate(meanRate(all)), k: 'mean XP/h' }
    : { v: `${Math.round((all.filter(p => p.met).length / all.length) * 100)}%`, k: 'reached the goal' },
  { v: dollars(all.reduce((n, p) => n + (p.cost_usd ?? 0), 0)), k: 'total cost' },
];
---

<Layout title={`${taskTitle(task)}${version === latestFor(task) ? '' : ` · ${versionLabel(version)}`}`} description={info?.summary}>
  <Section>
    <SectionHeader eyebrow="Results" title={taskTitle(task)} description={info?.summary} level={1}>
      <VersionPicker version={version} task={task} />
    </SectionHeader>
    {info && <p class="-mt-6 mb-10 max-w-xl font-mono text-xs text-faint">Scoring. {info.scoring}</p>}
    <ul class="mb-10 grid grid-cols-2 gap-3 sm:grid-cols-5">
      {tiles.map(tile => (
        <li class="rounded border border-hairline bg-raised px-4 py-3">
          <b class="block font-mono text-xl font-semibold text-fg tabular-nums">{tile.v}</b>
          <span class="text-xs text-muted">{tile.k}</span>
        </li>
      ))}
    </ul>
    <p class="eyebrow mb-3">Run reports</p>
    <ul class="mb-10 grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-3">
      {runs.map(r => {
        const t = totals(r);
        return (
          <li>
            <a href={url(`/results/${task}/${r.id}`)} class="group flex h-full flex-col justify-between gap-3 rounded border border-outline bg-raised p-4 transition-colors hover:border-accent">
              <span>
                <span class="block font-mono text-sm text-fg">{runDate(r)}</span>
                <span class="mt-1 block text-xs text-muted">
                  {isProgress(task)
                    ? `${r.players.length} players · best ${rate(bestRate(r.players))} · ${dollars(t.cost)}`
                    : `${t.met}/${r.players.length} reached the goal · ${t.first ? `fastest ${duration(t.first)}` : 'none in time'} · ${dollars(t.cost)}`}
                </span>
              </span>
              <span class="inline-flex items-center gap-1.5 font-mono text-xs text-accent">
                Open the run report <Icon name="lucide:arrow-right" class="size-3 transition-transform group-hover:translate-x-0.5" aria-hidden="true" />
              </span>
            </a>
          </li>
        );
      })}
    </ul>
    <Leaderboard task={task} version={version} />
    <div class="mt-8">
      <CostChart task={task} version={version} />
    </div>
  </Section>

  {boxes.size > 0 && (
    <Section>
      <SectionHeader eyebrow="Map" title="Routes" description="Every attempt from every run, coloured by model. Dungeons are drawn from their floor plans. Click a map to enlarge it." />
      <div class:list={['grid grid-cols-1 gap-4', boxes.size > 1 && 'lg:grid-cols-2']}>
        {[...boxes.values()].map(box => (
          <RouteMap box={box} routes={attempts} legend={entries.map(e => ({ key: e.key, name: entryName(e), cls: modelCls(e.key) }))} thin />
        ))}
      </div>
    </Section>
  )}

  <Section>
    <SectionHeader eyebrow="Models" title="By model" description="Each attempt's result, how each model's agent spent its time, and its most frequent errors." />
    <ModelInsights task={task} version={version} />
  </Section>

  <Section last>
    <SectionHeader eyebrow="Runs" title="All runs" description="Newest first. Open a run report for charts and details." />
    <div class="space-y-12">
      {runs.map(r => (
        <article id={r.id}>
          <div class="flex flex-wrap items-center justify-between gap-3">
            <h3 class="font-mono text-sm text-fg">
              {runDate(r)}
              <span class="text-faint"> · {r.scenario} · {r.minutes >= 1440 ? `${r.minutes / 1440} days` : `${r.minutes} min`} on the clock</span>
            </h3>
            <a href={url(`/results/${task}/${r.id}`)} class="inline-flex items-center gap-1.5 rounded bg-accent px-3 py-1.5 font-mono text-xs font-medium text-on-accent transition-opacity hover:opacity-90">
              Run report <Icon name="lucide:arrow-right" class="size-3" aria-hidden="true" />
            </a>
          </div>
          <div class="mt-3 overflow-x-auto rounded border border-hairline bg-raised">
            <table class="data">
              <thead>
                <tr>
                  <th>Character</th>
                  <th>Model</th>
                  <th>Harness</th>
                  <th>Class</th>
                  <th>Outcome</th>
                  <th class="num">{isProgress(task) ? 'XP/h' : 'Time'}</th>
                  <th class="num">Level</th>
                  <th class="num">Deaths</th>
                  <th class="num">Cost</th>
                </tr>
              </thead>
              <tbody>
                {r.players
                  .toSorted((a, b) => isProgress(task) ? (xpRate(b) ?? 0) - (xpRate(a) ?? 0) : Number(b.met) - Number(a.met) || (a.time_to_goal_s ?? Infinity) - (b.time_to_goal_s ?? Infinity))
                  .map(p => (
                    <tr>
                      <td class="text-fg">{p.char}</td>
                      <td class="text-fg">{entryName({ model: p.model, effort: effortOf(p) })}</td>
                      <td class="text-muted">{harnessName(p.runtime)}</td>
                      <td class="text-muted">{specLabel(p)}</td>
                      <td class:list={[outcome(p, isProgress(task)).good ? 'text-success' : 'text-warning']} title={p.gave_up}>{outcome(p, isProgress(task)).text}</td>
                      <td class="num">{isProgress(task) ? rate(xpRate(p)) : p.met ? duration(p.time_to_goal_s) : '–'}</td>
                      <td class="num text-muted">{p.level ?? '–'}</td>
                      <td class="num text-muted">{p.deaths ?? '–'}</td>
                      <td class="num text-muted">{dollars(p.cost_usd)}</td>
                    </tr>
                  ))}
              </tbody>
            </table>
          </div>
        </article>
      ))}
    </div>
  </Section>
</Layout>
