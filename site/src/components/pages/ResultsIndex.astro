---
import { Icon } from 'astro-icon/components';
import CrossCostChart from '../CrossCostChart.astro';
import CrossTask from '../CrossTask.astro';
import Section from '../Section.astro';
import SectionHeader from '../SectionHeader.astro';
import Layout from '../../layouts/Layout.astro';
import { TASKS, metricName, VERSIONS, latestFor, versionLabel, allRuns, dollars, duration, entryKey, entryName, isProgress, leaderboard, rate, runDate, runsOf, taskTitle, tasks } from '../../lib/results';
import { resultsUrl, url } from '../../lib/url';
import VersionPicker from '../VersionPicker.astro';

// Every task at one benchmark version (or 'all'): pages/results and pages/results/v/[version].
interface Props {
  version: string;
}

const { version } = Astro.props;
const all = allRuns(version);
const players = all.flatMap(r => r.players);
const entries = new Set(players.map(entryKey));
const last = all.at(-1);
const summary = [
  { v: String(tasks(version).length), k: 'tasks' },
  { v: String(all.length), k: 'runs' },
  { v: String(entries.size), k: 'models and efforts' },
  { v: String(players.length), k: 'attempts' },
  { v: dollars(players.reduce((n, p) => n + (p.cost_usd ?? 0), 0)), k: 'total cost' },
  { v: last ? runDate(last).split(',')[0] : '–', k: 'latest run' },
];
---

<Layout title={version === VERSIONS.at(-1)?.version ? 'Results' : `Results · ${versionLabel(version)}`} description="LEEROY benchmark results by model and task.">
  <Section>
    <SectionHeader
      eyebrow="Results"
      title="Results"
      description="Each task starts new characters in the same place with the same goal. Goal tasks are ranked by goals met and time, levelling tasks by XP per hour, and hardcore by total XP."
      level={1}
    >
      <VersionPicker version={version} />
    </SectionHeader>
    <ul class="grid grid-cols-2 gap-3 sm:grid-cols-3 lg:grid-cols-6">
      {summary.map(t => (
        <li class="rounded border border-hairline bg-raised px-4 py-3">
          <b class="block font-mono text-lg font-semibold whitespace-nowrap text-fg tabular-nums">{t.v}</b>
          <span class="text-xs text-muted">{t.k}</span>
        </li>
      ))}
    </ul>
  </Section>
  <Section>
    <SectionHeader eyebrow="Leaderboard" title="Every model on every task" description="One row per model and reasoning effort. Shading shows where an entry ranks within each task. Click a column to sort." />
    <CrossTask version={version} />
  </Section>
  <Section>
    <SectionHeader eyebrow="Cost" title="Result against cost" description="Tasks cost very different amounts, so each entry's cost is measured against the other entries in the same tasks." />
    <CrossCostChart version={version} />
  </Section>
  <Section last>
    <SectionHeader eyebrow="Tasks" title="Tasks" description="Each task page has its own leaderboard, cost chart, route maps and run reports." />
    <ul class="grid grid-cols-1 gap-4 md:grid-cols-2">
      {tasks(version).map(task => {
        const rows = leaderboard(task, version);
        const runs = runsOf(task, version);
        return (
          <li class="flex flex-col rounded border border-hairline bg-raised p-6">
            <p class="eyebrow mb-2">{isProgress(task) ? metricName(task)[0].toUpperCase() + metricName(task).slice(1) : 'Goal'} · {runs.length} run{runs.length === 1 ? '' : 's'} · {rows.length} entr{rows.length === 1 ? 'y' : 'ies'}</p>
            <h2 class="font-serif text-2xl text-fg">{taskTitle(task)}</h2>
            {TASKS[task] && <p class="mt-2 text-sm text-muted">{TASKS[task].summary}</p>}
            <ol class="mt-5 space-y-1.5 border-t border-hairline pt-4 font-mono text-xs">
              {rows.slice(0, 3).map((r, i) => (
                <li class="flex justify-between gap-4">
                  <span class="text-fg">
                    <span class="text-faint">{i + 1}.</span> {entryName(r)}
                  </span>
                  <span class="text-muted">
                    {isProgress(task) ? rate(r.meanRate, task) : `${r.met}/${r.attempts} · ${duration(r.meanTime)}`}
                  </span>
                </li>
              ))}
            </ol>
            <a href={resultsUrl(version, task, latestFor(task))} class="mt-6 inline-flex items-center gap-1.5 self-start font-mono text-xs text-accent hover:underline">
              Full results <Icon name="lucide:arrow-right" class="size-3" aria-hidden="true" />
            </a>
          </li>
        );
      })}
    </ul>
  </Section>
</Layout>
