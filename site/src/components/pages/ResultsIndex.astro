---
import { Icon } from 'astro-icon/components';
import CrossCostChart from '../CrossCostChart.astro';
import CrossTask from '../CrossTask.astro';
import Section from '../Section.astro';
import SectionHeader from '../SectionHeader.astro';
import Layout from '../../layouts/Layout.astro';
import { view } from '../../lib/kinds';
import { TASKS, VERSIONS, latestFor, versionLabel, allRuns, dollars, entryKey, entryName, leaderboard, runDate, runsOf, taskTitle, tasks } from '../../lib/results';
import { resultsUrl, url } from '../../lib/url';
import VersionPicker from '../VersionPicker.astro';

// Every task at one benchmark version (or 'all'): pages/results and pages/results/v/[version].
interface Props {
  version: string;
}

const { version } = Astro.props;
const all = allRuns(version);
const players = all.flatMap(r => r.players);
const entries = new Set(players.map(entryKey));
const last = all.at(-1);
const summary = [
  { v: String(tasks(version).length), k: 'tasks' },
  { v: String(all.length), k: 'runs' },
  { v: String(entries.size), k: 'models and efforts' },
  { v: String(players.length), k: 'attempts' },
  { v: dollars(players.reduce((n, p) => n + (p.cost_usd ?? 0), 0)), k: 'total cost' },
  { v: last ? runDate(last).split(',')[0] : '–', k: 'latest run' },
];
---

<Layout title={version === VERSIONS.at(-1)?.version ? 'Results' : `Results · ${versionLabel(version)}`} description="LEEROY benchmark results by model and task.">
  <Section>
    <SectionHeader
      eyebrow="Benchmark"
      title="Results"
      description="Every task starts new characters in the same place with the same goal, and ranks entries by what that goal measures: XP for levelling, goals met and time for a goal, a rating for head to head."
      level={1}
    >
      <VersionPicker version={version} />
    </SectionHeader>
    {all.length === 0 && (
      <p class="max-w-2xl rounded border border-hairline bg-raised p-5 text-sm leading-relaxed text-muted">
        No results are published yet. Runs are under way, and results will appear here as they are checked. In the
        meantime, the <a class="underline" href={url('/blog/gpt-6-1-sol-agents-clear-the-deadmines')}>Deadmines write-up</a> describes
        one long run.
      </p>
    )}
    <ul class:list={['grid grid-cols-2 gap-3 sm:grid-cols-3 lg:grid-cols-6', all.length === 0 && 'hidden']}>
      {summary.map(t => (
        <li class="rounded border border-hairline bg-raised px-4 py-3">
          <b class="block font-mono text-lg font-semibold whitespace-nowrap text-fg tabular-nums">{t.v}</b>
          <span class="text-xs text-muted">{t.k}</span>
        </li>
      ))}
    </ul>
  </Section>
  {all.length > 0 && <>
  <Section>
    <SectionHeader eyebrow="Leaderboard" title="Every model on every task" description="One row per model and reasoning effort, shaded by its rank in each task." />
    <CrossTask version={version} />
  </Section>
  <Section>
    <SectionHeader eyebrow="Cost" title="Result against cost" description="How well each entry did for what it cost, across the tasks it ran." />
    <CrossCostChart version={version} />
  </Section>
  <Section last>
    <SectionHeader eyebrow="Tasks" title="Task by task" description="Each task's top entries, with a link to its full results." />
    <ul class="grid grid-cols-1 gap-4 md:grid-cols-2">
      {tasks(version).map(task => {
        const rows = leaderboard(task, version);
        const runs = runsOf(task, version);
        return (
          <li class="flex flex-col rounded border border-hairline bg-raised p-6">
            <p class="eyebrow mb-2">{view(task, version).label} · {runs.length} run{runs.length === 1 ? '' : 's'} · {rows.length} entr{rows.length === 1 ? 'y' : 'ies'}</p>
            <h2 class="font-serif text-2xl text-fg">{taskTitle(task)}</h2>
            {TASKS[task] && <p class="mt-2 text-sm text-muted">{TASKS[task].summary}</p>}
            <ol class="mt-5 space-y-1.5 border-t border-hairline pt-4 font-mono text-xs">
              {rows.slice(0, 3).map((r, i) => (
                <li class="flex justify-between gap-4">
                  <span class="text-fg">
                    <span class="text-faint">{i + 1}.</span> {entryName(r)}
                  </span>
                  <span class="text-muted">
                    {view(task, version).cell(r)} · {view(task, version).sub(r)}
                  </span>
                </li>
              ))}
            </ol>
            <a href={resultsUrl(version, task, latestFor(task))} class="mt-6 inline-flex items-center gap-1.5 self-start font-mono text-xs text-accent hover:underline">
              Full results <Icon name="lucide:arrow-right" class="size-3" aria-hidden="true" />
            </a>
          </li>
        );
      })}
    </ul>
  </Section>
  </>}
</Layout>
