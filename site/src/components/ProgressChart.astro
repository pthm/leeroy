---
// Level over the run, one line per player, and under it a row per player with a tick at each death. Shaded: time
// inside an instance (amber) and party wipes (red). From the judge's samples and the recordings (azbench publish).
import PlayerName from './PlayerName.astro';
import Figure from './Figure.astro';
import { colors, duration, instanceTime, type Run, timeTicks, wipes, playerTip, entryName, effortOf } from '../lib/results';

interface Props {
  run: Run;
}

const { run } = Astro.props;
const ps = run.players.filter(p => p.series?.length);
const color = colors(run);
const end = Math.max(...ps.map(p => p.series!.at(-1)![0]));
const levels = ps.flatMap(p => p.series!.map(s => s[1]));
const lo = Math.floor(Math.min(...levels)), hi = Math.ceil(Math.max(...levels));
const W = 900, L = 210, R = 16, T = 12, CH = 260, ROW = 18, GAP = 34;
const H = T + CH + GAP + ps.length * ROW + 24;
const x = (s: number) => L + (Math.min(s, end) / end) * (W - L - R);
const y = (lvl: number) => T + CH - ((lvl - lo) / Math.max(1, hi - lo)) * CH;
const step = hi - lo > 20 ? 5 : hi - lo > 8 ? 2 : 1;
const yTicks = Array.from({ length: Math.floor((hi - lo) / step) + 1 }, (_, i) => lo + i * step);
const lines = ps.map(p => ({
  p,
  d: p.series!.map((s, i) => `${i ? 'L' : 'M'}${x(s[0]).toFixed(1)},${y(s[1]).toFixed(1)}`).join(''),
}));
const stripTop = T + CH + GAP;
const bottom = stripTop + ps.length * ROW;
const inside = instanceTime(run);
const wiped = wipes(run);
const note = `Each player's level from the judge's samples; the rows below mark a tick at each death.${wiped.length ? ' A wipe is three or more players dying within two minutes.' : ''}`;
// for the crosshair (scripts/interact.ts)
const seriesData = JSON.stringify({
  x0: L, x1: W - R, t1: end, top: T, bottom: bottom,
  lines: ps.map(p => ({ name: p.char, cls: color[p.char], pts: p.series!.map(s => [s[0], s[1]]) })),
});
---

<Figure title="Level over time" note={note}>
  <Fragment slot="legend">
    {ps.map(p => <button type="button" class={color[p.char]} data-toggle={p.char} aria-pressed="true">● <PlayerName p={p} class="text-muted" /></button>)}
    {inside.length > 0 && <span><span class="text-accent">▮</span> in a dungeon</span>}
    {wiped.length > 0 && <span><span class="text-error">▮</span> {wiped.length} wipes</span>}
    <button type="button" class="enlarge-btn" data-enlarge>Enlarge</button>
  </Fragment>
  <div class="overflow-x-auto">
    <svg viewBox={`0 0 ${W} ${H}`} class="w-full min-w-[640px]" role="img" aria-label="Each player's level over the run, and when each died" data-series={seriesData}>
      {inside.map(([a, b]) => (
        <rect x={x(a)} y={T} width={Math.max(1, x(b) - x(a))} height={bottom - T} fill="var(--color-accent)" opacity="0.08">
          <title>In a dungeon from {duration(a)} to {duration(b)}</title>
        </rect>
      ))}
      {wiped.map(([a, b]) => (
        <rect x={x(a) - 2} y={T} width={Math.max(4, x(b) - x(a) + 4)} height={bottom - T} fill="var(--color-error)" opacity="0.28">
          <title>Wipe at {duration(a)}</title>
        </rect>
      ))}
      {yTicks.map(v => (
        <g>
          <line x1={L} x2={W - R} y1={y(v)} y2={y(v)} stroke="var(--color-hairline)" />
          <text x={L - 8} y={y(v) + 4} text-anchor="end" class="fill-faint font-mono text-[11px]">{v}</text>
        </g>
      ))}
      {timeTicks(end).map(t => (
        <text x={x(t.s)} y={H - 6} text-anchor="middle" class="fill-faint font-mono text-[11px]">{t.label}</text>
      ))}
      {lines.map(({ p, d }) => (
        <path d={d} fill="none" stroke="currentColor" stroke-width="2" class={color[p.char]} data-key={p.char} />
      ))}
      {ps.map((p, i) => {
        const cy = stripTop + i * ROW + ROW / 2;
        return (
          <g class={color[p.char]} data-key={p.char}>
            <line x1={L} x2={W - R} y1={cy} y2={cy} stroke="var(--color-hairline)" />
            <text x={L - 8} y={cy + 4} text-anchor="end" class="fill-current font-mono text-[11px]"><title>{playerTip(p)}</title>{p.char}<tspan class="text-faint" fill="currentColor"> {entryName({ model: p.model, effort: effortOf(p) })}</tspan></text>
            {(p.deaths_at ?? []).map(s => (
              <line x1={x(s)} x2={x(s)} y1={cy - 6} y2={cy + 6} stroke="currentColor" stroke-width="2">
                <title>{p.char} died at {duration(s)}</title>
              </line>
            ))}
          </g>
        );
      })}
    </svg>
  </div>
</Figure>
