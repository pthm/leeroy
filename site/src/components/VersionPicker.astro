---
// The benchmark version shown, as a dropdown: a button with the current version, opening a list of every version
// with runs (for one task, or any), newest first, each with its date, run count and notes, then All versions. Built on
// <details>, so it works without JavaScript; scripts/interact.ts closes it on an outside click or Escape.
import { Icon } from 'astro-icon/components';
import { ALL, LATEST, allRuns, latestFor, runsOf, versionLabel, versionsOf } from '../lib/results';
import { resultsUrl } from '../lib/url';

interface Props {
  version: string;
  task?: string;
}

const { version, task } = Astro.props;
const latest = task ? latestFor(task) : LATEST;
const count = (v: string) => (task ? runsOf(task, v) : allRuns(v)).length;
const options = versionsOf(task)
  .toReversed()
  .map(v => ({ v: v.version, label: versionLabel(v.version), date: v.from.slice(0, 10), notes: v.notes }));
// pinned under the list, so it stays in view however many versions there are
const all = { v: ALL, label: versionLabel(ALL), date: '', notes: 'Runs from every version together. Versions differ, so compare within one where possible.' };
const plural = (n: number) => `${n} run${n === 1 ? '' : 's'}`;
---

<details class="version-picker relative" data-dropdown>
  <summary class="flex cursor-pointer list-none items-center gap-2 rounded border border-outline bg-raised px-3 py-2 font-mono text-xs text-fg transition-colors hover:border-accent">
    <span class="text-faint">Version</span>
    <span>{versionLabel(version)}{version === LATEST && <span class="text-faint"> · latest</span>}</span>
    <Icon name="lucide:chevron-down" class="chev size-3.5 text-muted transition-transform" aria-hidden="true" />
  </summary>
  <div class="absolute right-0 z-40 mt-2 w-[min(26rem,calc(100vw-3rem))] overflow-hidden rounded border border-outline bg-raised shadow-2xl">
    <ul class="max-h-72 divide-y divide-hairline overflow-y-auto">
      {options.map(o => (
        <li>
          <a
            href={resultsUrl(o.v, task, latest)}
            aria-current={o.v === version ? 'page' : undefined}
            class:list={['block px-4 py-3 transition-colors hover:bg-elevated', o.v === version && 'bg-elevated']}
          >
            <span class="flex items-baseline justify-between gap-3 font-mono text-xs">
              <span class:list={[o.v === version ? 'text-accent' : 'text-fg']}>
                {o.v === version ? '✓ ' : ''}
                {o.label}
                {o.v === LATEST && <span class="text-faint"> · latest</span>}
              </span>
              <span class="text-faint">{[o.date, plural(count(o.v))].filter(Boolean).join(' · ')}</span>
            </span>
            <span class="mt-1 block text-xs leading-relaxed text-muted">{o.notes}</span>
          </a>
        </li>
      ))}
    </ul>
    <div class="border-t border-outline">
        <div>
          <a
            href={resultsUrl(all.v, task, latest)}
            aria-current={all.v === version ? 'page' : undefined}
            class:list={['block px-4 py-3 transition-colors hover:bg-elevated', all.v === version && 'bg-elevated']}
          >
            <span class="flex items-baseline justify-between gap-3 font-mono text-xs">
              <span class:list={[all.v === version ? 'text-accent' : 'text-fg']}>
                {all.v === version ? '✓ ' : ''}
                {all.label}
                {all.v === LATEST && <span class="text-faint"> · latest</span>}
              </span>
              <span class="text-faint">{[all.date, plural(count(all.v))].filter(Boolean).join(' · ')}</span>
            </span>
            <span class="mt-1 block text-xs leading-relaxed text-muted">{all.notes}</span>
          </a>
        </div>
    </div>
  </div>
</details>
