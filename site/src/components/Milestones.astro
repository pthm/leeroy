---
// What each player reached and when, from its game log: quests turned in, achievements, levels and rare or better
// loot on one timeline per player, and the zones it went through in order.
import PlayerName from './PlayerName.astro';
import Figure from './Figure.astro';
import { colors, duration, timeTicks, type Run, playerTip, entryName, effortOf } from '../lib/results';

interface Props {
  run: Run;
}

const { run } = Astro.props;
const color = colors(run);
const glyph: Record<string, { g: string; c: string; label: string }> = {
  quest: { g: '!', c: 'var(--color-warning)', label: 'quest turned in' },
  achievement: { g: '★', c: 'var(--color-accent)', label: 'achievement' },
  level: { g: '▲', c: 'var(--color-success)', label: 'level' },
  loot: { g: '◆', c: '#0070dd', label: 'rare or better loot' },
};
const quality: Record<string, string> = { rare: '#0070dd', epic: '#a335ee', legendary: '#ff8000' };
const ps = run.players.filter(p => p.milestones?.length);
const end = Math.max(60, ...run.players.flatMap(p => [p.series?.at(-1)?.[0] ?? 0, ...(p.milestones ?? []).map(m => m.t)]));
const W = 900, L = 220, R = 12, ROW = 22;
const x = (s: number) => L + (s / end) * (W - L - R);
const H = ps.length * ROW + 26;
const zoned = run.players.filter(p => p.places?.length);
const kinds = Object.entries(glyph).filter(([k]) => ps.some(p => p.milestones!.some(m => m.kind === k)));
---

<div class="space-y-4">
  {ps.length > 0 && (
    <Figure title="Milestones" note="One row per player from its game log, each mark placed at the time it happened; loot marks take the item's quality colour.">
      <Fragment slot="legend">
        {kinds.map(([, v]) => <span><span style={`color:${v.c}`}>{v.g}</span> {v.label}</span>)}
      </Fragment>
      <div class="overflow-x-auto">
        <svg viewBox={`0 0 ${W} ${H}`} class="w-full min-w-[36rem]" role="img" aria-label="Each player's milestones over the run">
          {timeTicks(end).map(tk => (
            <g>
              <line x1={x(tk.s)} x2={x(tk.s)} y1={0} y2={H - 20} stroke="currentColor" class="text-hairline" />
              <text x={x(tk.s)} y={H - 6} text-anchor="middle" class="fill-current text-faint" font-size="10">{tk.label}</text>
            </g>
          ))}
          {ps.map((p, i) => (
            <g>
              <text x={0} y={i * ROW + 15} font-size="11" class:list={['fill-current', color[p.char]]}><title>{playerTip(p)}</title>{p.char}<tspan class="text-faint" fill="currentColor"> {entryName({ model: p.model, effort: effortOf(p) })}</tspan></text>
              <line x1={L} x2={W - R} y1={i * ROW + 11} y2={i * ROW + 11} stroke="currentColor" class="text-hairline" />
              {p.milestones!.map(m => (
                <text x={x(m.t)} y={i * ROW + 15} text-anchor="middle" font-size="12" fill={m.kind === 'loot' ? quality[m.quality ?? ''] ?? glyph.loot.c : glyph[m.kind]?.c}>
                  {glyph[m.kind]?.g ?? '•'}
                  <title>{`${duration(m.t)} · ${glyph[m.kind]?.label ?? m.kind}: ${m.kind === 'level' ? `level ${m.what}` : m.what}`}</title>
                </text>
              ))}
            </g>
          ))}
        </svg>
      </div>
    </Figure>
  )}
  {zoned.length > 0 && (
    <Figure title="Zones visited" note="The zones each player entered, in order, with the run time it arrived.">
      <ul class="space-y-1.5 text-xs">
        {zoned.map(p => (
          <li class="grid grid-cols-[14rem_1fr] gap-3">
            <PlayerName p={p} class={`truncate ${color[p.char]}`} />
            <span class="text-muted">
              {p.places!.map((z, i) => (
                <span>{i > 0 && <span class="text-faint"> → </span>}{z.zone} <span class="font-mono text-[11px] text-faint">{duration(z.t)}</span></span>
              ))}
            </span>
          </li>
        ))}
      </ul>
    </Figure>
  )}
</div>
