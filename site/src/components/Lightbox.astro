---
import { Icon } from 'astro-icon/components';

interface Props {
  id: string;
  image: string;
  srcset?: string; // smaller versions of image for the page; the popover shows image itself, once opened
  alt: string;
  priority?: boolean; // above the fold: load it first, not lazily
  openLabel?: string;
  closeLabel?: string;
  class?: string;
}

// Native Popover API: Esc and a click outside close it, and focus returns to
// the button that opened it, with no client script.
const { id, image, srcset, alt, priority = false, openLabel = 'Enlarge', closeLabel = 'Close', class: className } = Astro.props;
---

<button
  type="button"
  popovertarget={id}
  aria-label={openLabel}
  class:list={[className, "group relative block w-full cursor-zoom-in rounded border border-transparent transition-colors hover:border-accent focus-visible:border-accent"]}
>
  <img
    src={image}
    srcset={srcset}
    sizes="(min-width: 64rem) 61rem, 100vw"
    alt={alt}
    width="1600"
    height="1000"
    class="w-full rounded border border-hairline"
    loading={priority ? 'eager' : 'lazy'}
    fetchpriority={priority ? 'high' : undefined}
  />
  <span
    aria-hidden="true"
    class="absolute right-3 bottom-3 flex items-center gap-1.5 rounded border border-hairline bg-raised/90 px-2 py-1 font-mono text-[11px] text-muted transition-colors group-hover:text-accent"
  >
    <Icon name="lucide:maximize-2" class="size-3" />
    {openLabel}
  </span>
</button>

<div id={id} popover role="dialog" aria-label={alt} class="lightbox">
  <button
    type="button"
    popovertarget={id}
    popovertargetaction="hide"
    aria-label={closeLabel}
    autofocus
    class="lightbox-close"
  >
    <Icon name="lucide:x" class="size-4" aria-hidden="true" />
  </button>
  <img src={image} alt={alt} loading="lazy" />
</div>

<script>
  // The popover fills the viewport, so "click outside" never fires: a click on
  // its own backdrop (not the image or the close button) hides it.
  for (const box of document.querySelectorAll<HTMLElement>('.lightbox')) {
    box.addEventListener('click', event => {
      if (event.target === box) box.hidePopover();
    });
  }
</script>
