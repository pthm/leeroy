---
// A chart's heading: a title, an optional one-line explanation, and anything to put on the right (a legend, a hint).
interface Props {
  title: string;
  sub?: string;
}

const { title, sub } = Astro.props;
---

<header class="mb-4 flex flex-wrap items-end justify-between gap-x-6 gap-y-2">
  <div>
    <h3 class="font-serif text-lg leading-tight text-fg">{title}</h3>
    {sub && <p class="mt-0.5 text-xs text-muted">{sub}</p>}
  </div>
  <slot />
</header>
