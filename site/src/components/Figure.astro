---
// A figure (a chart, table, map or list) as every page shows one: a title above it only when its section holds more
// than one figure, the box (the figure itself, its legend or controls in a row at the top), and a short note below on
// how to read it. Text stays outside the box. data-chart: interact.ts's tooltips, legends and highlights.
interface Props {
  title?: string;
  note?: string;
  pad?: boolean; // padding in the box: charts and lists; tables sit flush (and scroll sideways)
  class?: string;
}

const { title, note, pad = true, class: cls } = Astro.props;
const legend = Astro.slots.has('legend');
const extra = Astro.slots.has('note');
---

<figure class:list={['min-w-0', cls]} data-chart>
  {title && <h3 class="mb-2 font-serif text-lg leading-tight text-fg">{title}</h3>}
  <div class:list={['rounded border border-hairline bg-raised', pad ? 'p-4' : 'overflow-x-auto']}>
    {legend && (
      <div class:list={['flex flex-wrap justify-end gap-x-3 gap-y-1 font-mono text-[11px] text-muted', pad ? 'mb-3' : 'px-4 pt-3']}>
        <slot name="legend" />
      </div>
    )}
    <slot />
  </div>
  {(note || extra) && (
    <figcaption class="mt-2 max-w-3xl font-mono text-[11px] leading-relaxed text-faint">
      {note}<slot name="note" />
    </figcaption>
  )}
</figure>
