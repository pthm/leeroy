---
// A task's models side by side, across every run: each attempt's time to the goal as a dot (the mean as a bar), how
// the agent spent its time on average, and its most frequent errors.
import FigureHead from './FigureHead.astro';
import { duration, entryKey, entryName, harnessColor, harnessName, isProgress, leaderboard, rate, runsOf, xpRate, type Player } from '../lib/results';

interface Props {
  task: string;
  version?: string;
}

const { task, version = 'all' } = Astro.props;
const rows = leaderboard(task, version);
const attempts = (key: string): Player[] => runsOf(task, version).flatMap(r => r.players.filter(p => entryKey(p) === key));
const progress = isProgress(task);
// each attempt's place on the strip: time to the goal (if met), or XP per hour on a progress task
const valueOf = (p: Player) => (progress ? xpRate(p) : p.met ? p.time_to_goal_s : undefined);
const label = (v?: number) => (progress ? rate(v) : duration(v));
const maxT = Math.max(...rows.flatMap(r => attempts(r.key).map(p => valueOf(p) ?? 0)), 1) * 1.05;
const states = [
  { k: 'thinking', label: 'thinking', c: 'var(--color-accent)' },
  { k: 'waiting', label: 'script running', c: 'var(--color-success)' },
  { k: 'in_call', label: 'in a call', c: 'var(--color-info)' },
  { k: 'no_script', label: 'nothing running', c: 'var(--color-outline)' },
];
const meanState = (ps: Player[], k: string) => ps.reduce((n, p) => n + (p.time_pct_by_state?.[k] ?? 0), 0) / Math.max(1, ps.length);
const topFailures = (ps: Player[]) => {
  const by = new Map<string, number>();
  for (const p of ps) for (const f of p.failures ?? []) by.set(`${f.op} ${f.code}`, (by.get(`${f.op} ${f.code}`) ?? 0) + f.count);
  return [...by.entries()].sort((a, b) => b[1] - a[1]).slice(0, 3);
};
const tickStep = progress
  ? [100, 200, 500, 1000, 2000, 5000, 10000, 20000].find(s => maxT / s <= 6) ?? 50000
  : ([1, 2, 5, 10, 15, 30, 60, 120, 240].find(m => maxT / 60 / m <= 6) ?? 480) * 60;
const ticks = Array.from({ length: Math.floor(maxT / tickStep) + 1 }, (_, i) => i * tickStep);
const tickLabel = (t: number) => (progress ? (t >= 1000 ? `${t / 1000}k` : String(t)) : t >= 7200 ? `${t / 3600} h` : `${t / 60} min`);
---

<div class="space-y-4">
  <figure class="rounded border border-hairline bg-raised p-4" data-chart>
    <FigureHead title={progress ? 'XP per hour, every attempt' : 'Time to the goal, every attempt'} sub={progress ? 'Each dot is one attempt. The line is the mean.' : 'Each dot is one attempt. The line is the mean. ✕ marks an attempt that didn’t reach the goal.'} />
    <ul class="space-y-2">
      {rows.map(r => (
        <li class="grid grid-cols-[8rem_1fr] items-center gap-3 font-mono text-xs" data-key={r.key}>
          <span class="truncate text-fg">{entryName(r)}</span>
          <span class="relative h-5 rounded-sm bg-elevated">
            {ticks.map(t => <span class="absolute top-0 h-full w-px bg-hairline" style={`left:${(t / maxT) * 100}%`} />)}
            {(progress ? r.meanRate : r.meanTime) && <span class="absolute -top-0.5 h-6 w-0.5 bg-fg" style={`left:${((progress ? r.meanRate! : r.meanTime!) / maxT) * 100}%`} title={`mean ${label(progress ? r.meanRate : r.meanTime)}`} />}
            {attempts(r.key).map(p =>
              valueOf(p) != null ? (
                <span
                  class:list={['absolute top-1/2 size-2.5 -translate-x-1/2 -translate-y-1/2 rounded-full', harnessColor(r.runtime).bg]}
                  style={`left:${((valueOf(p) ?? 0) / maxT) * 100}%`}
                  title={`${p.char}${progress ? ` (${p.spec_name || p.class})` : ''}: ${label(valueOf(p))}`}
                />
              ) : (
                <span class="absolute top-1/2 right-1 -translate-y-1/2 text-warning" title={`${p.char}: not met`}>✕</span>
              ),
            )}
          </span>
        </li>
      ))}
    </ul>
    <div class="mt-1 grid grid-cols-[8rem_1fr] gap-3 font-mono text-[11px] text-faint">
      <span />
      <span class="relative h-4">
        {ticks.map(t => <span class="absolute -translate-x-1/2" style={`left:${(t / maxT) * 100}%`}>{tickLabel(t)}</span>)}
      </span>
    </div>
  </figure>

  <div class="grid grid-cols-1 gap-4 md:grid-cols-2">
    <figure class="rounded border border-hairline bg-raised p-4" data-chart>
      <FigureHead title="Agent time" sub="Mean share of each attempt" />
      <ul class="space-y-2">
        {rows.map(r => {
          const ps = attempts(r.key);
          return (
            <li class="grid grid-cols-[8rem_1fr] items-center gap-3 text-xs">
              <span class="truncate font-mono text-fg">{entryName(r)}</span>
              <span class="flex h-3 overflow-hidden rounded-sm bg-elevated">
                {states.map(s => {
                  const v = meanState(ps, s.k);
                  return v > 0 && <span style={`width:${v}%;background:${s.c}`} title={`${s.label}: ${Math.round(v)}%`} />;
                })}
              </span>
            </li>
          );
        })}
      </ul>
      <p class="mt-3 flex flex-wrap gap-x-3 font-mono text-[11px] text-muted">
        {states.map(s => <span><span style={`color:${s.c}`}>■</span> {s.label}</span>)}
      </p>
    </figure>
    <figure class="rounded border border-hairline bg-raised p-4" data-chart>
      <FigureHead title="Most frequent errors" sub="SDK error codes, summed over all attempts" />
      <ul class="space-y-2.5">
        {rows.filter(r => topFailures(attempts(r.key)).length).map(r => (
          <li class="text-xs">
            <span class="font-mono text-fg">{entryName(r)} <span class="text-faint">{harnessName(r.runtime)}</span></span>
            <ul class="mt-0.5 space-y-0.5 font-mono text-[11px]">
              {topFailures(attempts(r.key)).map(([k, n]) => (
                <li class="flex justify-between gap-3">
                  <span class="truncate text-muted">{k.split(' ')[0]} <span class="text-warning">{k.split(' ')[1]}</span></span>
                  <span class="text-faint">{n}</span>
                </li>
              ))}
            </ul>
          </li>
        ))}
      </ul>
    </figure>
  </div>
  <p class="font-mono text-[11px] leading-relaxed text-faint">
    Agent time comes from the harness. Thinking is time the model spends generating. Script running is time the agent
    waits while its Lua plays. In a call is time a tool command is running. Nothing running means neither, and the
    character stands idle. Errors are the SDK's error codes summed over all attempts. Expected ones, such as a script
    replacing its own move, a missed attack or a spell on cooldown, are excluded.
</p>
</div>
