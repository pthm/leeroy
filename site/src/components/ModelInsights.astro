---
// A task's models side by side, across every run: each attempt's result as a dot (the mean as a bar; kinds.ts), how
// the agent spent its time on average, and its most frequent errors: three figures, each titled (Figure).
import Figure from './Figure.astro';
import { view } from '../lib/kinds';
import { entryKey, entryName, harnessColor, harnessName, isProgress, leaderboard, runsOf, type Player } from '../lib/results';

interface Props {
  task: string;
  version?: string;
}

const { task, version = 'all' } = Astro.props;
const rows = leaderboard(task, version);
const attempts = (key: string): Player[] => runsOf(task, version).flatMap(r => r.players.filter(p => entryKey(p) === key));
// each attempt's place on the strip, as the task's goal kind reads it (kinds.ts)
const st = view(task, version).strip;
const progress = isProgress(task);
const valueOf = st.value;
const label = st.label;
const maxT = st.max ?? Math.max(...rows.flatMap(r => attempts(r.key).map(p => valueOf(p) ?? 0)), 1) * 1.05;
const states = [
  { k: 'thinking', label: 'thinking', c: 'var(--color-accent)' },
  { k: 'waiting', label: 'script running', c: 'var(--color-success)' },
  { k: 'in_call', label: 'in a call', c: 'var(--color-info)' },
  { k: 'no_script', label: 'nothing running', c: 'var(--color-outline)' },
];
const meanState = (ps: Player[], k: string) => ps.reduce((n, p) => n + (p.time_pct_by_state?.[k] ?? 0), 0) / Math.max(1, ps.length);
const topFailures = (ps: Player[]) => {
  const by = new Map<string, number>();
  for (const p of ps) for (const f of p.failures ?? []) by.set(`${f.op} ${f.code}`, (by.get(`${f.op} ${f.code}`) ?? 0) + f.count);
  return [...by.entries()].sort((a, b) => b[1] - a[1]).slice(0, 3);
};
const tickStep = st.step(maxT);
const ticks = Array.from({ length: Math.floor(maxT / tickStep + 1e-9) + 1 }, (_, i) => i * tickStep);
const tickLabel = st.tick;
---

<div class="space-y-4">
  <Figure title={st.title} note={st.sub}>
    <ul class="space-y-2">
      {rows.map(r => (
        <li class="grid grid-cols-[8rem_1fr] items-center gap-3 font-mono text-xs" data-key={r.key}>
          <span class="truncate text-fg">{entryName(r)}</span>
          <span class="relative h-5 rounded-sm bg-elevated">
            {ticks.map(t => <span class="absolute top-0 h-full w-px bg-hairline" style={`left:${(t / maxT) * 100}%`} />)}
            {st.mean(r) != null && <span class="absolute -top-0.5 h-6 w-0.5 bg-fg" style={`left:${((st.mean(r) ?? 0) / maxT) * 100}%`} title={`mean ${label(st.mean(r))}`} />}
            {attempts(r.key).map(p =>
              valueOf(p) != null ? (
                <span
                  class:list={['absolute top-1/2 size-2.5 -translate-x-1/2 -translate-y-1/2 rounded-full', harnessColor(r.runtime).bg]}
                  style={`left:${((valueOf(p) ?? 0) / maxT) * 100}%`}
                  title={`${p.char}${progress ? ` (${p.spec_name || p.class})` : ''}: ${label(valueOf(p))}`}
                />
              ) : (
                <span class="absolute top-1/2 right-1 -translate-y-1/2 text-warning" title={`${p.char}: not met`}>✕</span>
              ),
            )}
          </span>
        </li>
      ))}
    </ul>
    <div class="mt-1 grid grid-cols-[8rem_1fr] gap-3 font-mono text-[11px] text-faint">
      <span />
      <span class="relative h-4">
        {ticks.map(t => <span class="absolute -translate-x-1/2" style={`left:${(t / maxT) * 100}%`}>{tickLabel(t)}</span>)}
      </span>
    </div>
  </Figure>

  <div class="grid grid-cols-1 gap-4 md:grid-cols-2">
    <Figure
      title="Agent time"
      note="Mean share of each attempt, from the harness. Script running is the agent waiting while its Lua plays; in a call, a tool command running; nothing running, the character idle."
    >
      <Fragment slot="legend">
        {states.map(s => <span><span style={`color:${s.c}`}>■</span> {s.label}</span>)}
      </Fragment>
      <ul class="space-y-2">
        {rows.map(r => {
          const ps = attempts(r.key);
          return (
            <li class="grid grid-cols-[8rem_1fr] items-center gap-3 text-xs">
              <span class="truncate font-mono text-fg">{entryName(r)}</span>
              <span class="flex h-3 overflow-hidden rounded-sm bg-elevated">
                {states.map(s => {
                  const v = meanState(ps, s.k);
                  return v > 0 && <span style={`width:${v}%;background:${s.c}`} title={`${s.label}: ${Math.round(v)}%`} />;
                })}
              </span>
            </li>
          );
        })}
      </ul>
    </Figure>
    <Figure
      title="Most frequent errors"
      note="SDK error codes summed over all attempts, leaving out expected ones such as a missed attack or a spell on cooldown."
    >
      <ul class="space-y-2.5">
        {rows.filter(r => topFailures(attempts(r.key)).length).map(r => (
          <li class="text-xs">
            <span class="font-mono text-fg">{entryName(r)} <span class="text-faint">{harnessName(r.runtime)}</span></span>
            <ul class="mt-0.5 space-y-0.5 font-mono text-[11px]">
              {topFailures(attempts(r.key)).map(([k, n]) => (
                <li class="flex justify-between gap-3">
                  <span class="truncate text-muted">{k.split(' ')[0]} <span class="text-warning">{k.split(' ')[1]}</span></span>
                  <span class="text-faint">{n}</span>
                </li>
              ))}
            </ul>
          </li>
        ))}
      </ul>
    </Figure>
  </div>
</div>
