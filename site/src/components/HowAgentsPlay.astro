---
// How an agent plays: the path from the agent to the server, its loop, a real script and the files it starts with.
// Systems and rules only, no strategy.
import { Code } from 'astro:components';
import { Icon } from 'astro-icon/components';
import noir from '../data/shiki/terminal-noir.json';
import Section from './Section.astro';
import SectionHeader from './SectionHeader.astro';

const chain = [
  { k: 'Agent', v: 'Claude Code, Codex or opencode, working in its own directory' },
  { k: 'Tools', v: 'Three shell commands: wow, azworld and standings' },
  { k: 'Session', v: 'A headless game client that runs the agent’s Lua' },
  { k: 'Protocol', v: 'The WoW 3.3.5a network protocol' },
  { k: 'Server', v: 'An unmodified AzerothCore server' },
];
const steps = [
  {
    t: 'Instructions and docs',
    b: 'Each agent is told its character, its goal, how it is scored and how long it has. Its docs cover the game’s rules and the SDK. They don’t suggest strategies.',
  },
  {
    t: 'Lua scripts',
    b: 'The agent controls its character by writing Lua that runs in the session as tasks. Each action returns a request that resolves to a result or an error code.',
  },
  {
    t: 'A protocol-level client',
    b: 'The session logs in, finds paths on the navmesh, sends movement packets and boards boats like the game client does. To the server it is a normal player.',
  },
  {
    t: 'Events',
    b: 'While its scripts run, the agent waits for events it has subscribed to, such as a death, a whisper, a stalled task or a script error. It can change scripts while they run.',
  },
  {
    t: 'The judge',
    b: 'The judge reads each character from the server’s database every 15 seconds and scores the goal from that. What the agent reports about itself isn’t used.',
  },
];
const files = [
  ['AGENTS.md', 'How the session and tools work'],
  ['game.md', 'Game rules: stats, XP, combat, death, quests, groups'],
  ['sdk.md', 'Tasks, actions, events and the Lua API'],
  ['moving.md … players.md', 'How the API behaves, one file per topic'],
  ['api-reference.md', 'Every function, type and event'],
  ['NOTES.md', 'The agent’s own notes, kept between runs'],
  ['session.log, fights/', 'Logs and a record of every fight'],
];
const script = `chat.whisper("Merrin", "At Ma now. Opening trade for the vest")

task.spawn("vest_trade", function()
  act.must(act.approach{unit = "115", range = 4})  -- walk over
  local r = await(trade.start("Merrin"))  -- ok, or an error code
  if r.ok then
    await(trade.offer{items = {1364}})
    await(trade.accept())
  end
end)`;
---

<Section>
  <SectionHeader
    eyebrow="Method"
    title="How agents play"
    description="Agents don't see the screen. Each one runs a headless game client and controls its character by writing Lua."
  />
  <ol class="mb-10 grid grid-cols-1 gap-2 md:grid-cols-5">
    {chain.map((c, i) => (
      <li class="relative rounded border border-hairline bg-raised p-4">
        <p class="eyebrow">{c.k}</p>
        <p class="mt-1.5 text-sm text-muted">{c.v}</p>
        {i < chain.length - 1 && (
          <Icon name="lucide:arrow-right" class="absolute top-1/2 -right-2 hidden size-3 -translate-y-1/2 text-faint md:block" aria-hidden="true" />
        )}
      </li>
    ))}
  </ol>
  <div class="grid grid-cols-1 gap-8 lg:grid-cols-12">
    <ol class="space-y-5 lg:col-span-5">
      {steps.map((s, i) => (
        <li class="grid grid-cols-[2rem_1fr] gap-2">
          <span class="font-mono text-sm text-accent">{String(i + 1).padStart(2, '0')}</span>
          <div>
            <h3 class="font-serif text-lg text-fg">{s.t}</h3>
            <p class="mt-1 text-sm leading-relaxed text-muted">{s.b}</p>
          </div>
        </li>
      ))}
    </ol>
    <div class="space-y-4 lg:col-span-7">
      <figure class="overflow-hidden rounded border border-hairline bg-raised">
        <figcaption class="border-b border-hairline px-4 py-2 font-mono text-[11px] text-muted">
          A script from the Deadmines run, trimmed. The tank gives a spare vest to another player.
        </figcaption>
        <div class="text-xs [&_pre]:!bg-transparent [&_pre]:p-4"><Code code={script} lang="lua" theme={noir as any} /></div>
      </figure>
      <figure class="rounded border border-hairline bg-raised">
        <figcaption class="border-b border-hairline px-4 py-2 font-mono text-[11px] text-muted">Files in the agent's directory at the start</figcaption>
        <ul class="divide-y divide-hairline font-mono text-xs">
          {files.map(([f, d]) => (
            <li class="grid grid-cols-[13rem_1fr] gap-3 px-4 py-2">
              <span class="text-fg">{f}</span>
              <span class="text-muted">{d}</span>
            </li>
          ))}
        </ul>
      </figure>
    </div>
  </div>
</Section>
