---
// Routes over one map: on the server's terrain (a continent) or the instance's navmesh floor plan, each route in its
// colour, a cross at each death (hover for who killed them) and a dot where each one ended.
import { getImage } from 'astro:assets';
import { duration, type MapBox, type Player } from '../lib/results';

export interface Route {
  key: string; // for the legend: hide, show, highlight (a player, or a model on task pages)
  name: string; // shown on hover
  cls: string; // a colour class (classColor, pc-n)
  track: NonNullable<Player['track']>;
  deaths: NonNullable<Player['death_list']>;
}

interface Props {
  box: MapBox;
  routes: Route[];
  legend: { key: string; name: string; cls: string }[];
  thin?: boolean; // many routes: thinner, fainter lines, no end dots
}

const { box, routes, legend, thin = false } = Astro.props;
const images = import.meta.glob<{ default: ImageMetadata }>('../assets/runs/*.{jpg,png}', { eager: true });
const img = box.file ? images[`../assets/runs/${box.file}`]?.default : undefined;
// WebP at build time: half size on the page, full size only when enlarged (scripts/interact.ts swaps it in)
const small = img && (await getImage({ src: img, format: 'webp', width: Math.round(img.width / 2), quality: 72 }));
const full = img && (await getImage({ src: img, format: 'webp', width: img.width, quality: 72 }));
const W = img?.width ?? 1000;
const H = img?.height ?? Math.round((W * (box.x_max - box.x_min)) / (box.y_max - box.y_min));
// north (+x) up, west (+y) left, as in the game
const px = (x: number, y: number) => [((box.y_max - y) / (box.y_max - box.y_min)) * W, ((box.x_max - x) / (box.x_max - box.x_min)) * H];
const drawn = routes.map(r => {
  const pts = r.track.filter(t => t[1] === box.map);
  let d = '';
  let rides = '';
  let prev: (typeof pts)[number] | undefined;
  let rideFrom: (typeof pts)[number] | undefined;
  for (const t of r.track) {
    // marks from azbench publish: -1 a teleport (the route breaks), -2 a ride on a boat or zeppelin whose position
    // skipped ahead (a dashed line to where it picked up); another map or a long gap breaks it too
    if (t[1] !== box.map) {
      rideFrom = t[1] === -2 ? prev : undefined;
      prev = undefined;
      continue;
    }
    const [cx, cy] = px(t[2], t[3]);
    if (rideFrom) {
      const [fx, fy] = px(rideFrom[2], rideFrom[3]);
      rides += `M${fx.toFixed(1)},${fy.toFixed(1)}L${cx.toFixed(1)},${cy.toFixed(1)}`;
      rideFrom = undefined;
    }
    d += `${!prev || t[0] - prev[0] > 900 ? 'M' : 'L'}${cx.toFixed(1)},${cy.toFixed(1)}`;
    prev = t;
  }
  const end = pts.at(-1);
  return { r, d, rides, end: end && px(end[2], end[3]), deaths: r.deaths.filter(x => x.map === box.map) };
});
const stroke = Math.max(1.5, W / (thin ? 450 : 600)); // in the map's units, for dots and crosses
const line = thin ? 1.4 : 1.8; // screen pixels, whatever the zoom
const floor = box.file?.endsWith('.png');
const anyRide = drawn.some(x => x.rides);
---

<figure class="rounded border border-hairline bg-raised p-4" data-chart>
  <p class="mb-2 font-mono text-xs text-muted">{box.name} <span class="enlarge-hide text-faint">· click to enlarge</span></p>
  <div class="map-click overflow-hidden rounded border border-hairline" data-enlarge role="button" tabindex="0" aria-label={`Enlarge the map of ${box.name}`}>
    <svg viewBox={`0 0 ${W} ${H}`} class="block w-full" role="img" aria-label={`Routes in ${box.name}`} data-zoom>
      <rect width={W} height={H} fill="var(--color-base)" />
      {img && <image href={small!.src} data-full={full!.src} width={W} height={H} opacity={floor ? 0.8 : 0.7} style={floor ? 'filter:grayscale(1)' : undefined} />}
      {drawn.map(x => (
        <g class={x.r.cls} data-key={x.r.key}>
          <path d={x.d} fill="none" stroke="currentColor" stroke-width={line} vector-effect="non-scaling-stroke" stroke-linejoin="round" stroke-linecap="round" opacity={thin ? 0.8 : 0.9}>
            <title>{x.r.name}</title>
          </path>
          {x.rides && <path d={x.rides} fill="none" stroke="currentColor" stroke-width={line} vector-effect="non-scaling-stroke" stroke-dasharray="4 4" opacity="0.7" />}
          {!thin && x.end && <circle cx={x.end[0]} cy={x.end[1]} r={stroke * 2.2} fill="currentColor" stroke="var(--color-base)" stroke-width={stroke / 2} />}
          {x.deaths.map(d => {
            const [cx, cy] = px(d.x, d.y);
            const s = stroke * 2.5;
            return (
              <path d={`M${cx - s},${cy - s}L${cx + s},${cy + s}M${cx - s},${cy + s}L${cx + s},${cy - s}`} stroke="currentColor" stroke-width={line + 0.6} vector-effect="non-scaling-stroke">
                <title>{x.r.name} killed by {d.killer || 'unknown'} in {d.place}, {duration(d.t)} in</title>
              </path>
            );
          })}
        </g>
      ))}
    </svg>
  </div>
  <figcaption class="mt-3 flex flex-wrap gap-x-4 gap-y-1 font-mono text-[11px] text-muted">
    {legend.map(l => (
      <button type="button" class={l.cls} data-toggle={l.key} aria-pressed="true">● <span class="text-muted">{l.name}</span></button>
    ))}
    <span class="text-faint">× death{!thin && ' · ● final position'}{anyRide && ' · dashed line: boat'} · {floor ? 'floor plan from the navmesh' : 'game map in greyscale'}</span>
  </figcaption>
</figure>
