---
// Every player's route over one map, in their colour, on the server's terrain (continents; an instance has no terrain,
// so a plain floor), with a cross at each death (hover for who killed them) and a dot where each one ended.
import { colors, duration, type MapBox, type Run } from '../lib/results';

interface Props {
  run: Run;
  box: MapBox;
}

const { run, box } = Astro.props;
const images = import.meta.glob<{ default: ImageMetadata }>('../assets/runs/*.jpg', { eager: true });
const img = box.file ? images[`../assets/runs/${box.file}`]?.default : undefined;
const W = img?.width ?? 1000;
const H = img?.height ?? Math.round((W * (box.x_max - box.x_min)) / (box.y_max - box.y_min));
// north (+x) up, west (+y) left, as in the game
const px = (x: number, y: number) => [((box.y_max - y) / (box.y_max - box.y_min)) * W, ((box.x_max - x) / (box.x_max - box.x_min)) * H];
const color = colors(run);
const far = Math.min(1500, (box.y_max - box.y_min) / 8); // a jump this long is a teleport, not a walk
const routes = run.players.map(p => {
  const pts = (p.track ?? []).filter(t => t[1] === box.map);
  let d = '';
  let prev: (typeof pts)[number] | undefined;
  for (const t of pts) {
    const [cx, cy] = px(t[2], t[3]);
    // a new stroke after a teleport, a hearthstone or a stretch on another map
    const jump = !prev || Math.hypot(t[2] - prev[2], t[3] - prev[3]) > far || t[0] - prev[0] > 900;
    d += `${jump ? 'M' : 'L'}${cx.toFixed(1)},${cy.toFixed(1)}`;
    prev = t;
  }
  const end = pts.at(-1);
  return { p, d, end: end && px(end[2], end[3]), deaths: (p.death_list ?? []).filter(x => x.map === box.map) };
});
const stroke = Math.max(1.5, W / 600);
---

<figure class="rounded border border-hairline bg-raised p-4">
  <p class="mb-2 font-mono text-xs text-muted">{box.name}</p>
  <div class="overflow-hidden rounded border border-hairline">
    <svg viewBox={`0 0 ${W} ${H}`} class="block w-full" role="img" aria-label={`Every player's route in ${box.name}`}>
      {img ? <image href={img.src} width={W} height={H} opacity="0.75" /> : <rect width={W} height={H} fill="var(--color-elevated)" />}
      {routes.map(r => (
        <g class={color[r.p.char]}>
          <path d={r.d} fill="none" stroke="currentColor" stroke-width={stroke} stroke-linejoin="round" stroke-linecap="round" opacity="0.9">
            <title>{r.p.char}</title>
          </path>
          {r.end && <circle cx={r.end[0]} cy={r.end[1]} r={stroke * 2.2} fill="currentColor" stroke="var(--color-base)" stroke-width={stroke / 2} />}
          {r.deaths.map(d => {
            const [cx, cy] = px(d.x, d.y);
            const s = stroke * 2.5;
            return (
              <path d={`M${cx - s},${cy - s}L${cx + s},${cy + s}M${cx - s},${cy + s}L${cx + s},${cy - s}`} stroke="currentColor" stroke-width={stroke}>
                <title>{r.p.char} killed by {d.killer || 'unknown'} in {d.place}, {duration(d.t)} in</title>
              </path>
            );
          })}
        </g>
      ))}
    </svg>
  </div>
  <figcaption class="mt-3 flex flex-wrap gap-x-4 gap-y-1 font-mono text-[11px] text-muted">
    {routes.map(r => <span class={color[r.p.char]}>● <span class="text-muted">{r.p.char}</span></span>)}
    <span class="text-faint">× death · ● where they ended · terrain from the server's height maps</span>
  </figcaption>
</figure>
