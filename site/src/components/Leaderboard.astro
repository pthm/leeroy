---
// A task's entries (a model at an effort), best first, with the columns its goal kind reads by (kinds.ts) and the
// note on how to read them below it (Figure).
import Figure from './Figure.astro';
import FilterBar from './FilterBar.astro';
import { view } from '../lib/kinds';
import { LABS, dollars, entryName, harnessName, leaderboard, thousands } from '../lib/results';

interface Props {
  task: string;
  version?: string; // a benchmark version, or 'all'
  compact?: boolean; // the home page: no tokens column
}

const { task, version = 'all', compact = false } = Astro.props;
const rows = leaderboard(task, version);
const v = view(task, version);
const cols = v.board.filter(c => !compact || !c.wide);
---

<div data-filtered>
{!compact && <FilterBar rows={rows} />}
<Figure pad={false} note={compact ? undefined : `${v.boardNote}Cost per attempt is at list prices (models.dev); “· high” is the reasoning effort.`}>
  <table class="data">
    <thead>
      <tr>
        <th class="num">#</th>
        <th>Model</th>
        <th>Harness</th>
        {cols.map(c => <th class:list={[c.num && 'num']}>{c.head}</th>)}
        <th class="num">Cost / attempt</th>
        {!compact && <th class="num">Output tokens</th>}
      </tr>
    </thead>
    <tbody>
      {rows.map((r, i) => (
        <tr data-lab={r.lab}>
          <td class="num text-faint">{i + 1}</td>
          <td class="font-medium text-fg"><span style={`color:${LABS[r.lab]}`} title={r.lab}>●</span> {entryName(r)}</td>
          <td class="text-muted">{harnessName(r.runtime)}</td>
          {cols.map(c => <td class:list={[c.num && 'num', c.tone?.(r) ?? 'text-muted']} title={c.title?.(r)}>{c.cell(r)}</td>)}
          <td class="num text-muted">{dollars(r.meanCost)}</td>
          {!compact && <td class="num text-muted">{thousands(r.meanOutputTokens)}</td>}
        </tr>
      ))}
    </tbody>
  </table>
</Figure>
</div>
