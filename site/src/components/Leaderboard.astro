---
// A task's entries (a model at an effort), best first: goals met, then mean time; or on a progress task, mean XP per
// hour. With the formulas under it.
import { LABS, dollars, duration, entryName, harnessName, isProgress, leaderboard, rate, thousands } from '../lib/results';

interface Props {
  task: string;
  compact?: boolean; // the home page: no tokens column
}

const { task, compact = false } = Astro.props;
const rows = leaderboard(task);
const progress = isProgress(task);
---

<div class="overflow-x-auto rounded border border-hairline bg-raised">
  <table class="data">
    <thead>
      <tr>
        <th class="num">#</th>
        <th>Model</th>
        <th>Harness</th>
        {progress ? <th class="num">Attempts</th> : <th class="num">Met</th>}
        <th class="num">{progress ? 'Mean' : 'Mean time'}</th>
        <th class="num">Best</th>
        {progress && <th class="num">Levels</th>}
        <th class="num">Cost / attempt</th>
        {!progress && !compact && <th class="num">Cost / success</th>}
        {!compact && <th class="num">Output tokens</th>}
      </tr>
    </thead>
    <tbody>
      {rows.map((r, i) => (
        <tr>
          <td class="num text-faint">{i + 1}</td>
          <td class="font-medium text-fg"><span style={`color:${LABS[r.lab]}`} title={r.lab}>●</span> {entryName(r)}</td>
          <td class="text-muted">{harnessName(r.runtime)}</td>
          {progress ? (
            <td class="num text-muted">{r.attempts}</td>
          ) : (
            <td class:list={['num', r.met === r.attempts ? 'text-success' : 'text-warning']}>{r.met}/{r.attempts}</td>
          )}
          <td class="num text-fg">{progress ? rate(r.meanRate) : duration(r.meanTime)}</td>
          <td class="num text-muted">{progress ? rate(r.bestRate) : duration(r.bestTime)}</td>
          {progress && <td class="num text-muted">{r.meanLevels?.toFixed(1) ?? '–'}</td>}
          <td class="num text-muted">{dollars(r.meanCost)}</td>
          {!progress && !compact && <td class="num text-muted">{dollars(r.costPerSuccess)}</td>}
          {!compact && <td class="num text-muted">{thousands(r.meanOutputTokens)}</td>}
        </tr>
      ))}
    </tbody>
  </table>
</div>
{!compact && (
  <p class="mt-3 font-mono text-[11px] leading-relaxed text-faint">
    {progress
      ? 'XP/h is XP earned divided by hours played, from the judge’s samples every 15 seconds. Mean and best are over all attempts. Levels is the mean number of levels gained. '
      : 'Met counts attempts that reached the goal before time ran out. Time runs from the start until the judge first records the goal, checked every 15 seconds. Mean and best time cover only attempts that met the goal. Cost per success is the total cost of all attempts divided by goals met, and is left blank if any cost is missing. '}
    Cost per attempt is the mean token cost at list prices from models.dev. A suffix such as “· high” is the reasoning effort. No suffix means the runtime’s default. Most entries have one to three attempts, so small differences in rank don’t mean much.
  </p>
)}
