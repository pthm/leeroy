---
// Filters for a leaderboard: by lab, a row of chips (All, or one lab) built from the rows shown, not shown when there's
// only one. Put it and the table inside one [data-filtered] element, with data-lab on each body row;
// scripts/interact.ts hides the rows that don't match.
import { LABS } from '../lib/results';

interface Props {
  rows: { lab: string }[];
}

const { rows } = Astro.props;
const distinct = (xs: string[]) => [...new Set(xs)];
const groups = [
  { key: 'lab', label: 'Lab', options: distinct(rows.map(r => r.lab)).sort().map(v => ({ v, label: v, dot: LABS[v] })) },
].filter(g => g.options.length > 1);
const chip = 'rounded-sm px-2.5 py-1 transition-colors text-muted hover:text-fg aria-pressed:bg-elevated aria-pressed:text-fg aria-pressed:shadow-[inset_0_0_0_1px_var(--color-outline)]';
---

{groups.length > 0 && (
  <div class="mb-3 flex flex-wrap items-center gap-x-5 gap-y-2 font-mono text-[11px]" role="toolbar" aria-label="Filter the leaderboard">
    {groups.map(g => (
      <div class="flex items-center gap-2" role="group" aria-label={g.label} data-filter={g.key}>
        <span class="tracking-wider text-faint uppercase">{g.label}</span>
        <div class="flex rounded border border-hairline bg-raised p-0.5">
          <button type="button" class={chip} data-value="" aria-pressed="true">All</button>
          {g.options.map(o => (
            <button type="button" class={chip} data-value={o.v} aria-pressed="false">
              {o.dot && <span style={`color:${o.dot}`} aria-hidden="true">● </span>}{o.label}
            </button>
          ))}
        </div>
      </div>
    ))}
    <span class="ml-auto flex items-center gap-3 text-faint" data-filter-status hidden>
      <span data-filter-count></span>
      <button type="button" class="text-accent hover:underline" data-filter-reset>Reset</button>
    </span>
  </div>
)}
