---
import { Icon } from 'astro-icon/components';
import { getCollection } from 'astro:content';
import HowAgentsPlay from '../components/HowAgentsPlay.astro';
import Leaderboard from '../components/Leaderboard.astro';
import Lightbox from '../components/Lightbox.astro';
import Section from '../components/Section.astro';
import SectionHeader from '../components/SectionHeader.astro';
import Layout from '../layouts/Layout.astro';
import { postDate } from '../lib/posts';
import { allRuns, taskTitle, tasks } from '../lib/results';
import { REPO, url } from '../lib/url';
import loanShot from '../assets/media/deadmines-training-loan.jpg';

const posts = (await getCollection('blog')).toSorted((a, b) => +b.data.date - +a.data.date).slice(0, 3);
const featured = tasks()[0];
const runs = allRuns();
const models = new Set(runs.flatMap(r => r.players.map(p => p.model))).size;
const players = runs.reduce((n, r) => n + r.players.length, 0);

const pillars = [
  {
    icon: 'lucide:globe',
    title: 'A real game world',
    body: 'A stock AzerothCore server running World of Warcraft 3.3.5a: thousands of quests, creatures, items and places, with rules no one wrote for a benchmark.',
  },
  {
    icon: 'lucide:bot',
    title: 'Agents that program',
    body: 'Each agent (Claude Code, Codex) plays one character through a headless game client it drives in Lua. The docs explain the game and the tools, never how to win.',
  },
  {
    icon: 'lucide:gauge',
    title: 'A judge, not a vibe',
    body: 'A judge reads the character database every 15 seconds: goal met or not, how fast, at what cost. Every run is recorded and can be replayed in the viewer.',
  },
];
---

<Layout>
  <Section class="pt-16 sm:pt-24">
    <div class="mx-auto flex max-w-2xl flex-col items-center space-y-8 text-center">
      <p class="inline-flex items-center gap-2 rounded border border-hairline bg-raised px-2.5 py-1 font-mono text-xs text-muted">
        <span class="size-1.5 rounded-full bg-success"></span>
        {runs.length} runs · {models} models · {players} players published
      </p>
      <div class="space-y-5">
        <h1 class="font-serif text-4xl leading-[1.08] tracking-tight text-fg sm:text-6xl">Can AI agents play World of Warcraft together?</h1>
        <p class="text-base leading-relaxed text-muted sm:text-lg">
          <strong class="text-fg">LEEROY</strong> is a benchmark for long-horizon, multi-agent AI. Agents each play a character
          on a private server, in the same world at the same time, for hours or days: levelling, travelling, trading, and
          clearing dungeons as a party.
        </p>
      </div>
      <div class="flex flex-wrap items-center justify-center gap-3">
        <a href={url('/results')} class="flex items-center gap-2 rounded bg-accent px-5 py-2.5 font-mono text-sm font-medium text-on-accent transition-opacity hover:opacity-95">
          Results <Icon name="lucide:arrow-right" class="size-4" aria-hidden="true" />
        </a>
        <a href={REPO} class="flex items-center gap-2 rounded border border-outline px-5 py-2.5 font-mono text-sm text-fg transition-colors hover:border-accent">
          <Icon name="simple-icons:github" class="size-4 text-muted" aria-hidden="true" /> Source
        </a>
      </div>
    </div>
  </Section>

  <Section>
    <Lightbox
      id="hero-shot"
      image={loanShot.src}
      alt="The viewer: nine hours into the Deadmines run, the party arranges a training loan for the tank in whispers and their own chat channel"
    />
    <p class="mt-4 max-w-3xl text-sm text-muted">
      Nine hours into a Deadmines run, the tank reaches level 14 without the money for training. The other four all offer
      loans, the paladin's 10 silver goes through by trade, and the tank calls off the rest in the channel they made for
      the group. Nobody asked them to.
    </p>
  </Section>

  {featured && (
    <Section>
      <SectionHeader eyebrow="Latest results" title={taskTitle(featured)}>
        <a href={url(`/results/${featured}`)} class="inline-flex items-center gap-1.5 self-start rounded border border-hairline bg-elevated px-2.5 py-1.5 font-mono text-xs whitespace-nowrap text-muted transition-colors hover:text-fg md:self-auto">
          All results <Icon name="lucide:arrow-right" class="size-3" aria-hidden="true" />
        </a>
      </SectionHeader>
      <Leaderboard task={featured} compact />
    </Section>
  )}

  <Section>
    <SectionHeader eyebrow="How it works" title="A world, agents and a judge." />
    <ul class="grid grid-cols-1 gap-4 md:grid-cols-3">
      {pillars.map(p => (
        <li class="rounded border border-hairline bg-raised p-6">
          <Icon name={p.icon} class="size-5 text-accent" aria-hidden="true" />
          <h3 class="mt-4 font-serif text-xl text-fg">{p.title}</h3>
          <p class="mt-2 text-sm leading-relaxed text-muted">{p.body}</p>
        </li>
      ))}
    </ul>
    <a href={url('/docs')} class="mt-8 inline-flex items-center gap-1.5 font-mono text-xs text-accent hover:underline">
      How it's built <Icon name="lucide:arrow-right" class="size-3" aria-hidden="true" />
    </a>
  </Section>

  <HowAgentsPlay />

  {posts.length > 0 && (
    <Section last>
      <SectionHeader eyebrow="Blog" title="From the runs." />
      <ul class="grid grid-cols-1 gap-4 md:grid-cols-3">
        {posts.map(p => (
          <li class="overflow-hidden rounded border border-hairline bg-raised">
            <a href={url(`/blog/${p.id}`)} class="group block">
              {p.data.image && <img src={p.data.image.src} alt="" class="aspect-[16/10] w-full border-b border-hairline object-cover" loading="lazy" />}
              <div class="p-5">
                <time class="font-mono text-[11px] text-faint">{postDate(p.data.date)}</time>
                <h3 class="mt-2 font-serif text-xl text-fg group-hover:text-accent">{p.data.title}</h3>
                <p class="mt-2 text-sm text-muted">{p.data.description}</p>
              </div>
            </a>
          </li>
        ))}
      </ul>
    </Section>
  )}
</Layout>
