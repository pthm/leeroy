---
// One run: tiles, findings, the roster, charts, and the story (src/content/runs/<id>.md, when written).
import { getEntry, render } from 'astro:content';
import FinishChart from '../../../components/FinishChart.astro';
import Deaths from '../../../components/Deaths.astro';
import MatchCards from '../../../components/MatchCards.astro';
import { view } from '../../../lib/kinds';
import CombatPanel from '../../../components/CombatPanel.astro';
import Targets from '../../../components/Targets.astro';
import Milestones from '../../../components/Milestones.astro';
import Heard from '../../../components/Heard.astro';
import Downloads from '../../../components/Downloads.astro';
import ProgressChart from '../../../components/ProgressChart.astro';
import RouteMap from '../../../components/RouteMap.astro';
import SectionHeader from '../../../components/SectionHeader.astro';
import CostPanel from '../../../components/CostPanel.astro';
import TrajectoryPanel from '../../../components/TrajectoryPanel.astro';
import KitPanel from '../../../components/KitPanel.astro';
import Talk from '../../../components/Talk.astro';
import TimeUse from '../../../components/TimeUse.astro';
import AgentPanel from '../../../components/AgentPanel.astro';
import ToolMix from '../../../components/ToolMix.astro';
import Section from '../../../components/Section.astro';
import Layout from '../../../layouts/Layout.astro';
import {
  allRuns,
  colors,
  dollars,
  harnessName,
  runDate,
  specLabel,
  TASKS,
  latestFor,
  versionLabel,
  effortOf,
  entryName,
  playerTip,
  outageNote,
  taskTitle,
  thousands,
  type Run,
} from '../../../lib/results';
import { asset, hasAssets, resultsUrl } from '../../../lib/url';

export function getStaticPaths() {
  return allRuns().map(run => ({ params: { task: run.task, run: run.id }, props: { run } }));
}

const { run } = Astro.props as { run: Run };
const notes = await getEntry('runs', run.id);
const Story = notes ? (await render(notes)).Content : null;
const levelled = run.players.some(p => p.series && p.series.at(-1)![1] - p.series[0][1] > 0.5);
const kv = view(run.task);
const title = notes?.data.title ?? `Run of ${runDate(run)}`;
const lede = notes?.data.lede ?? TASKS[run.task]?.summary ?? run.description;
const roster = run.players.toSorted(kv.playerOrder);
const color = colors(run);
const hasChat = (run.chat_per_min ?? []).some(h => Object.values(h).some(Boolean));
const hasHeard = run.players.some(p => Object.keys(p.heard_from ?? {}).length);
const hasDownloads = hasAssets && run.players.some(p => p.downloads && Object.keys(p.downloads).length);
const hasDeaths = run.players.some(p => p.death_list?.length);
const hasCombat = run.players.some(p => (p.combat && (p.combat.damage_dealt || p.combat.healing_done || p.combat.damage_taken)) || p.kills_by?.length);
const clock = run.minutes >= 1440 ? `${run.minutes / 1440} days` : `${run.minutes} min`;

const tiles = kv.runTiles(run).filter(tile => levelled || tile.k !== 'quests completed');
---

<Layout title={`${title} · ${taskTitle(run.task)}`} description={lede}>
  <Section>
    <a href={resultsUrl(run.version, run.task, latestFor(run.task))} class="eyebrow hover:underline">← {taskTitle(run.task)} · {versionLabel(run.version)}</a>
    <h1 class="mt-4 font-serif text-4xl leading-tight text-fg sm:text-5xl">{title}</h1>
    <p class="mt-4 max-w-3xl text-lg leading-relaxed text-muted">{lede}</p>
    <p class="mt-4 font-mono text-xs text-faint">
      {runDate(run)} · {versionLabel(run.version)} · {run.scenario} · goal <code>{run.goal}</code> · {clock} on the clock{run.hardcore && ' · hardcore'}
    </p>
    <ul class="mt-10 grid grid-cols-2 gap-3 sm:grid-cols-3 lg:grid-cols-6">
      {tiles.map(tile => (
        <li class="rounded border border-hairline bg-raised px-4 py-3">
          <b class="block font-mono text-lg font-semibold whitespace-nowrap text-fg tabular-nums">{tile.v}</b>
          <span class="text-xs text-muted">{tile.k}</span>
        </li>
      ))}
    </ul>
  </Section>

  {notes && notes.data.glance.length > 0 && (
    <Section>
      <SectionHeader eyebrow="Summary" title="At a glance" />
      <ul class="grid grid-cols-1 gap-3 md:grid-cols-2">
        {notes.data.glance.map(g => (
          <li class="rounded border border-hairline bg-raised p-5">
            <p class="font-medium text-fg">{g.head}</p>
            <p class="mt-1.5 text-sm leading-relaxed text-muted">{g.body}</p>
          </li>
        ))}
      </ul>
    </Section>
  )}

  <Section>
    <SectionHeader eyebrow="Players" title="Outcomes" description="Each player's model, result, cost and tokens." />
    <div class="overflow-x-auto rounded border border-hairline bg-raised">
      <table class="data">
        <thead>
          <tr>
            <th>Character</th>
            <th>Class</th>
            <th>Model</th>
            <th>Outcome</th>
            <th class:list={[kv.player.num && 'num']}>{kv.player.head}</th>
            {levelled && <th class="num">Level</th>}
            <th class="num">Deaths</th>
            {levelled && <th class="num">Quests</th>}
            <th class="num">Cost</th>
            <th class="num">Output</th>
            {hasDownloads && <th>Downloads</th>}
          </tr>
        </thead>
        <tbody>
          {roster.map(p => (
            <tr>
              <td class:list={['font-medium', color[p.char]]} title={playerTip(p)}>{p.char}</td>
              <td class="text-muted">{specLabel(p)}{p.role && <span class="text-faint"> · {p.role}</span>}</td>
              <td class="text-fg">{entryName({ model: p.model, effort: effortOf(p) })} <span class="text-faint">{harnessName(p.runtime)}</span></td>
              <td class:list={[kv.outcome(p).good ? 'text-success' : 'text-warning']} title={outageNote(p) ?? p.gave_up}>{kv.outcome(p).text}{outageNote(p) && <span class="ml-1 text-warning" aria-label={outageNote(p)}>⚠</span>}</td>
              <td class:list={[kv.player.num && 'num']}>{kv.player.cell(p)}</td>
              {levelled && <td class="num text-muted">{p.series?.at(-1)?.[1].toFixed(1) ?? p.level ?? '–'}</td>}
              <td class="num text-muted">{p.deaths ?? '–'}</td>
              {levelled && <td class="num text-muted">{p.series?.at(-1)?.[4] ?? '–'}</td>}
              <td class="num text-muted">{dollars(p.cost_usd)}</td>
              <td class="num text-muted">{thousands(p.tokens?.output)}</td>
              {hasDownloads && (
                <td class="whitespace-nowrap text-muted">
                  {p.downloads?.trajectory && <a class="underline hover:text-fg" href={asset(p.downloads.trajectory)} download title="The agent's trajectory (ATIF JSON)">trajectory</a>}
                  {p.downloads?.trajectory && p.downloads?.game_log && ' · '}
                  {p.downloads?.game_log && <a class="underline hover:text-fg" href={asset(p.downloads.game_log)} download title="The character's game log (JSON lines, gzipped)">game log</a>}
                </td>
              )}
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </Section>

  {kv.kind === 'versus' && (
    <Section>
      <SectionHeader eyebrow="Matches" title="Game by game" description="Each match's games in order: who won, when and how." />
      <MatchCards run={run} />
    </Section>
  )}

  {kv.kind !== 'versus' && <Section>
    <SectionHeader eyebrow="Progress" title="How the run went" description={levelled ? 'Levels, milestones and zones over the run.' : 'Who reached the goal when, and what each player did on the way.'} />
    <div class="space-y-4">
      {levelled ? <ProgressChart run={run} /> : <FinishChart run={run} />}
      <Milestones run={run} />
    </div>
  </Section>}

  {(run.maps ?? []).length > 0 && (
    <Section>
      <SectionHeader eyebrow="Map" title="Routes" description="Each player's path over the game map." />
      <div class:list={['grid grid-cols-1 gap-4', run.maps!.length > 1 && 'lg:grid-cols-2']}>
        {run.maps!.map(box => (
          <RouteMap
            box={box}
            routes={run.players.map(p => ({ key: p.char, name: p.char, cls: color[p.char], track: p.track ?? [], deaths: p.death_list ?? [] }))}
            legend={run.players.map(p => ({ key: p.char, name: p.char, cls: color[p.char] }))}
          />
        ))}
      </div>
    </Section>
  )}

  {(hasCombat || hasDeaths) && (
    <Section>
      <SectionHeader eyebrow="Combat" title={hasDeaths ? 'Fighting and deaths' : 'Fighting'} description={`Damage, healing and kills from each game log${hasDeaths ? ', and who killed whom where' : ''}.`} />
      <div class="space-y-4">
        {hasCombat && <CombatPanel run={run} />}
        {hasCombat && <Targets run={run} />}
        {hasDeaths && <Deaths run={run} />}
      </div>
    </Section>
  )}

  <Section>
    <SectionHeader eyebrow="Time" title="Time use" description="Where each character's and each agent's time went." />
    <TimeUse run={run} />
  </Section>

  {run.players.some(p => p.idle_gaps || p.reliability || p.coop || p.play) && (
    <Section>
      <SectionHeader eyebrow="Agent" title="How the agents worked" description="What each agent ran, and how often the tooling got in its way." />
      <div class="space-y-4">
        <ToolMix run={run} />
        <AgentPanel run={run} />
      </div>
    </Section>
  )}

  {run.players.some(p => p.trajectory?.length || p.failures?.length) && (
    <Section>
      <SectionHeader eyebrow="Trajectory" title="Calls and errors" description="What each agent asked the game to do, and where it failed." />
      <TrajectoryPanel run={run} />
    </Section>
  )}

  {(hasChat || hasHeard) && run.players.length > 1 && (
    <Section>
      <SectionHeader eyebrow="Group" title="Chat and proximity" description="Chat between players, who heard whom, and time together." />
      <div class="space-y-4">
        {hasChat && <Talk run={run} />}
        {hasHeard && <Heard run={run} />}
      </div>
    </Section>
  )}

  {run.players.some(p => p.kit || Object.keys(p.casts ?? {}).length) && (
    <Section>
      <SectionHeader eyebrow="Characters" title="Gear, talents and abilities" description="What each character wore and knew at the end, and what it cast." />
      <KitPanel run={run} />
    </Section>
  )}

  <Section last={!Story && !hasDownloads}>
    <SectionHeader eyebrow="Spend" title="Cost" description="What each agent cost, and its tokens." />
    <CostPanel run={run} />
  </Section>

  {hasDownloads && (
    <Section last={!Story}>
      <SectionHeader eyebrow="Data" title="Downloads" description="Each agent's trajectory and each character's game log." />
      <Downloads run={run} />
    </Section>
  )}

  {Story && (
    <Section last>
      <SectionHeader eyebrow="Write-up" title="Account of the run" />
      <div class="prose run-story max-w-3xl">
        <Story />
      </div>
    </Section>
  )}
</Layout>
