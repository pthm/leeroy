---
// One run: tiles, findings, the roster, charts, and the story (src/content/runs/<id>.md, when written).
import { getEntry, render } from 'astro:content';
import FinishChart from '../../../components/FinishChart.astro';
import Deaths from '../../../components/Deaths.astro';
import CombatPanel from '../../../components/CombatPanel.astro';
import ProgressChart from '../../../components/ProgressChart.astro';
import RouteMap from '../../../components/RouteMap.astro';
import SectionHeader from '../../../components/SectionHeader.astro';
import CostPanel from '../../../components/CostPanel.astro';
import TrajectoryPanel from '../../../components/TrajectoryPanel.astro';
import KitPanel from '../../../components/KitPanel.astro';
import Talk from '../../../components/Talk.astro';
import TimeUse from '../../../components/TimeUse.astro';
import AgentPanel from '../../../components/AgentPanel.astro';
import Section from '../../../components/Section.astro';
import Layout from '../../../layouts/Layout.astro';
import {
  allRuns,
  colors,
  dollars,
  duration,
  harnessName,
  modelName,
  runDate,
  specLabel,
  TASKS,
  latestFor,
  versionLabel,
  effortOf,
  entryName,
  isProgress,
  levelsGained,
  outageNote,
  outcome,
  bestRate,
  rate,
  unit,
  xpRate,
  taskTitle,
  thousands,
  totals,
  type Run,
} from '../../../lib/results';
import { resultsUrl, url } from '../../../lib/url';

export function getStaticPaths() {
  return allRuns().map(run => ({ params: { task: run.task, run: run.id }, props: { run } }));
}

const { run } = Astro.props as { run: Run };
const notes = await getEntry('runs', run.id);
const Story = notes ? (await render(notes)).Content : null;
const t = totals(run);
const levelled = run.players.some(p => p.series && p.series.at(-1)![1] - p.series[0][1] > 0.5);
const progress = isProgress(run.task);
const title = notes?.data.title ?? `Run of ${runDate(run)}`;
const lede = notes?.data.lede ?? TASKS[run.task]?.summary ?? run.description;
const roster = run.players.toSorted((a, b) =>
  progress ? (xpRate(b) ?? 0) - (xpRate(a) ?? 0) : Number(b.met) - Number(a.met) || (a.time_to_goal_s ?? Infinity) - (b.time_to_goal_s ?? Infinity),
);
const color = colors(run);
const hasChat = (run.chat_per_min ?? []).some(h => Object.values(h).some(Boolean));
const hasDeaths = run.players.some(p => p.death_list?.length);
const hasCombat = run.players.some(p => p.combat && (p.combat.damage_dealt || p.combat.healing_done || p.combat.damage_taken));
const clock = run.minutes >= 1440 ? `${run.minutes / 1440} days` : `${run.minutes} min`;

const best = bestRate(run.players);
const meanLevels = run.players.reduce((n, p) => n + (levelsGained(p) ?? 0), 0) / run.players.length;
const tiles = [
  ...(progress
    ? [
        { v: rate(best, run.task), k: 'best' },
        { v: meanLevels.toFixed(1), k: 'levels gained, mean' },
      ]
    : [
        { v: `${t.met}/${run.players.length}`, k: 'reached the goal' },
        { v: t.last ? duration(t.last) : duration(t.first), k: t.last ? 'until all reached it' : t.first ? 'first to the goal' : 'none in time' },
      ]),
  { v: String(t.deaths), k: 'deaths' },
  ...(levelled ? [{ v: String(t.quests), k: 'quests completed' }] : []),
  { v: dollars(t.cost), k: 'cost at list prices' },
  { v: thousands(t.output), k: 'output tokens' },
];
---

<Layout title={`${title} · ${taskTitle(run.task)}`} description={lede}>
  <Section>
    <a href={resultsUrl(run.version, run.task, latestFor(run.task))} class="eyebrow hover:underline">← {taskTitle(run.task)} · {versionLabel(run.version)}</a>
    <h1 class="mt-4 font-serif text-4xl leading-tight text-fg sm:text-5xl">{title}</h1>
    <p class="mt-4 max-w-3xl text-lg leading-relaxed text-muted">{lede}</p>
    <p class="mt-4 font-mono text-xs text-faint">
      {runDate(run)} · {versionLabel(run.version)} · {run.scenario} · goal <code>{run.goal}</code> · {clock} on the clock{run.hardcore && ' · hardcore'}
    </p>
    <ul class="mt-10 grid grid-cols-2 gap-3 sm:grid-cols-3 lg:grid-cols-6">
      {tiles.map(tile => (
        <li class="rounded border border-hairline bg-raised px-4 py-3">
          <b class="block font-mono text-lg font-semibold whitespace-nowrap text-fg tabular-nums">{tile.v}</b>
          <span class="text-xs text-muted">{tile.k}</span>
        </li>
      ))}
    </ul>
  </Section>

  {notes && notes.data.glance.length > 0 && (
    <Section>
      <p class="eyebrow mb-6">At a glance</p>
      <ul class="grid grid-cols-1 gap-3 md:grid-cols-2">
        {notes.data.glance.map(g => (
          <li class="rounded border border-hairline bg-raised p-5">
            <p class="font-medium text-fg">{g.head}</p>
            <p class="mt-1.5 text-sm leading-relaxed text-muted">{g.body}</p>
          </li>
        ))}
      </ul>
    </Section>
  )}

  <Section>
    <p class="eyebrow mb-6">Players</p>
    <div class="overflow-x-auto rounded border border-hairline bg-raised">
      <table class="data">
        <thead>
          <tr>
            <th>Character</th>
            <th>Class</th>
            <th>Model</th>
            <th>Outcome</th>
            <th class="num">{progress ? unit(run.task) : 'Time'}</th>
            {levelled && <th class="num">Level</th>}
            <th class="num">Deaths</th>
            {levelled && <th class="num">Quests</th>}
            <th class="num">Cost</th>
            <th class="num">Output</th>
          </tr>
        </thead>
        <tbody>
          {roster.map(p => (
            <tr>
              <td class:list={['font-medium', color[p.char]]}>{p.char}</td>
              <td class="text-muted">{specLabel(p)}{p.role && <span class="text-faint"> · {p.role}</span>}</td>
              <td class="text-fg">{entryName({ model: p.model, effort: effortOf(p) })} <span class="text-faint">{harnessName(p.runtime)}</span></td>
              <td class:list={[outcome(p, progress).good ? 'text-success' : 'text-warning']} title={outageNote(p) ?? p.gave_up}>{outcome(p, progress).text}{outageNote(p) && <span class="ml-1 text-warning" aria-label={outageNote(p)}>⚠</span>}</td>
              <td class="num">{progress ? rate(xpRate(p), run.task) : p.met ? duration(p.time_to_goal_s) : '–'}</td>
              {levelled && <td class="num text-muted">{p.series?.at(-1)?.[1].toFixed(1) ?? p.level ?? '–'}</td>}
              <td class="num text-muted">{p.deaths ?? '–'}</td>
              {levelled && <td class="num text-muted">{p.series?.at(-1)?.[4] ?? '–'}</td>}
              <td class="num text-muted">{dollars(p.cost_usd)}</td>
              <td class="num text-muted">{thousands(p.tokens?.output)}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </Section>

  <Section>
    <SectionHeader eyebrow="Progress" title={levelled ? 'Level over time' : 'Time to the goal'} description={levelled ? 'Level from the judge\'s samples, with deaths marked below. Shading shows time in a dungeon and party wipes.' : 'Time from the start of the run to the goal, fastest first.'} />
    {levelled ? <ProgressChart run={run} /> : <FinishChart run={run} />}
  </Section>

  {(run.maps ?? []).length > 0 && (
    <Section>
      <SectionHeader eyebrow="Map" title="Routes" description="Each player's path from their recording, drawn over the game map. Crosses mark deaths. Click a map to enlarge it." />
      <div class:list={['grid grid-cols-1 gap-4', run.maps!.length > 1 && 'lg:grid-cols-2']}>
        {run.maps!.map(box => (
          <RouteMap
            box={box}
            routes={run.players.map(p => ({ key: p.char, name: p.char, cls: color[p.char], track: p.track ?? [], deaths: p.death_list ?? [] }))}
            legend={run.players.map(p => ({ key: p.char, name: p.char, cls: color[p.char] }))}
          />
        ))}
      </div>
    </Section>
  )}

  {(hasCombat || hasDeaths) && (
    <Section>
      <SectionHeader eyebrow="Combat" title={hasDeaths ? 'Fighting and deaths' : 'Fighting'} description={`Each player's damage, healing and kills from its game log${hasDeaths ? ', then deaths by killer and by zone' : ''}.`} />
      <div class="space-y-4">
        {hasCombat && <CombatPanel run={run} />}
        {hasDeaths && <Deaths run={run} />}
      </div>
    </Section>
  )}

  <Section>
    <SectionHeader eyebrow="Time" title="Time use" description="How each character spent its time in the game, and how each agent spent its time." />
    <TimeUse run={run} />
  </Section>

  {run.players.some(p => p.idle_gaps || p.reliability || p.coop) && (
    <Section>
      <SectionHeader eyebrow="Agent" title="How the agents worked" description="Progress by what each agent was doing, the time it left its character idle, and how often the tooling got in its way." />
      <AgentPanel run={run} />
    </Section>
  )}

  {run.players.some(p => p.trajectory?.length || p.failures?.length) && (
    <Section>
      <SectionHeader eyebrow="Trajectory" title="Calls and errors" description="What each agent asked the game to do over the run, where its calls failed, and the errors it hit most often." />
      <TrajectoryPanel run={run} />
    </Section>
  )}

  {hasChat && run.players.length > 1 && (
    <Section>
      <SectionHeader eyebrow="Group" title="Chat and proximity" description="Messages between players over the run, and how often the whole party was within 40 yards of each other." />
      <Talk run={run} />
    </Section>
  )}

  {run.players.some(p => p.kit || Object.keys(p.casts ?? {}).length) && (
    <Section>
      <SectionHeader eyebrow="Characters" title="Gear, talents and abilities" description="What each character wore and had learned when the run ended, and how often it cast each ability." />
      <KitPanel run={run} />
    </Section>
  )}

  <Section last={!Story}>
    <SectionHeader eyebrow="Spend" title="Cost" description="What each agent cost over the run, and its tokens." />
    <CostPanel run={run} />
  </Section>

  {Story && (
    <Section last>
      <p class="eyebrow mb-2">Account of the run</p>
      <div class="prose run-story max-w-3xl">
        <Story />
      </div>
    </Section>
  )}
</Layout>
