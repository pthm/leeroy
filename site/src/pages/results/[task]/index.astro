---
import CostChart from '../../../components/CostChart.astro';
import Leaderboard from '../../../components/Leaderboard.astro';
import ModelInsights from '../../../components/ModelInsights.astro';
import RouteMap from '../../../components/RouteMap.astro';
import Section from '../../../components/Section.astro';
import SectionHeader from '../../../components/SectionHeader.astro';
import Layout from '../../../layouts/Layout.astro';
import { Icon } from 'astro-icon/components';
import { TASKS, dollars, duration, harnessName, leaderboard, modelName, runDate, runsOf, taskTitle, tasks, totals, type MapBox } from '../../../lib/results';
import { url } from '../../../lib/url';

export function getStaticPaths() {
  return tasks().map(task => ({ params: { task } }));
}

const { task } = Astro.params;
const info = TASKS[task];
const runs = runsOf(task).toReversed();
const all = runs.flatMap(r => r.players);
// one map per map the runs crossed: the widest run's box (its backdrop), every attempt over it in its model's colour
const models = leaderboard(task).map(r => r.model);
const modelCls = (m: string) => `pc-${models.indexOf(m) % 8}`;
const boxes = new Map<number, MapBox>();
for (const r of runs)
  for (const b of r.maps ?? []) {
    const have = boxes.get(b.map);
    if (!have || (b.x_max - b.x_min) * (b.y_max - b.y_min) > (have.x_max - have.x_min) * (have.y_max - have.y_min)) boxes.set(b.map, b);
  }
const attempts = runs.flatMap(r =>
  r.players.map(p => ({ name: `${modelName(p.model)} · ${runDate(r)}`, cls: modelCls(p.model), track: p.track ?? [], deaths: p.death_list ?? [] })),
);
const tiles = [
  { v: String(runs.length), k: runs.length === 1 ? 'run' : 'runs' },
  { v: String(new Set(all.map(p => p.model)).size), k: 'models' },
  { v: String(all.length), k: 'attempts' },
  { v: `${Math.round((all.filter(p => p.met).length / all.length) * 100)}%`, k: 'reached the goal' },
  { v: dollars(all.reduce((n, p) => n + (p.cost_usd ?? 0), 0)), k: 'spent, all runs' },
];
const outcome = (p: (typeof runs)[number]['players'][number]) =>
  p.met ? 'met' : p.gave_up ? 'gave up' : p.died ? 'died' : 'not met';
---

<Layout title={taskTitle(task)} description={info?.summary}>
  <Section>
    <SectionHeader eyebrow="Results" title={taskTitle(task)} description={info?.summary} level={1} />
    {info && <p class="-mt-6 mb-10 max-w-xl font-mono text-xs text-faint">Scoring: {info.scoring}</p>}
    <ul class="mb-10 grid grid-cols-2 gap-3 sm:grid-cols-5">
      {tiles.map(tile => (
        <li class="rounded border border-hairline bg-raised px-4 py-3">
          <b class="block font-mono text-xl font-semibold text-fg tabular-nums">{tile.v}</b>
          <span class="text-xs text-muted">{tile.k}</span>
        </li>
      ))}
    </ul>
    <p class="eyebrow mb-3">Run reports</p>
    <ul class="mb-10 grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-3">
      {runs.map(r => {
        const t = totals(r);
        return (
          <li>
            <a href={url(`/results/${task}/${r.id}`)} class="group flex h-full flex-col justify-between gap-3 rounded border border-outline bg-raised p-4 transition-colors hover:border-accent">
              <span>
                <span class="block font-mono text-sm text-fg">{runDate(r)}</span>
                <span class="mt-1 block text-xs text-muted">{t.met}/{r.players.length} reached the goal · first in {duration(t.first)} · {dollars(t.cost)}</span>
              </span>
              <span class="inline-flex items-center gap-1.5 font-mono text-xs text-accent">
                Open the run report <Icon name="lucide:arrow-right" class="size-3 transition-transform group-hover:translate-x-0.5" aria-hidden="true" />
              </span>
            </a>
          </li>
        );
      })}
    </ul>
    <Leaderboard task={task} />
    <div class="mt-8">
      <CostChart task={task} />
    </div>
  </Section>

  {boxes.size > 0 && (
    <Section>
      <SectionHeader eyebrow="Where they went" title="Every route." description="Every attempt in every run, one colour per model, over the server's own terrain (an instance: its floor plan). Hover a line for the attempt, a cross for the killer." />
      <div class:list={['grid grid-cols-1 gap-4', boxes.size > 1 && 'lg:grid-cols-2']}>
        {[...boxes.values()].map(box => (
          <RouteMap box={box} routes={attempts} legend={models.map(m => ({ name: modelName(m), cls: modelCls(m) }))} thin />
        ))}
      </div>
    </Section>
  )}

  <Section>
    <SectionHeader eyebrow="By model" title="Model by model." description="Every attempt rather than the mean alone, where each model's agent spent its time, and the errors it kept running into." />
    <ModelInsights task={task} />
  </Section>

  <Section last>
    <SectionHeader eyebrow="Runs" title="Run by run." description="Newest first. Every player in every run, as the judge left them; open a run for its charts and story." />
    <div class="space-y-12">
      {runs.map(r => (
        <article id={r.id}>
          <div class="flex flex-wrap items-center justify-between gap-3">
            <h3 class="font-mono text-sm text-fg">
              {runDate(r)}
              <span class="text-faint"> · {r.scenario} · {r.minutes >= 1440 ? `${r.minutes / 1440} days` : `${r.minutes} min`} on the clock</span>
            </h3>
            <a href={url(`/results/${task}/${r.id}`)} class="inline-flex items-center gap-1.5 rounded bg-accent px-3 py-1.5 font-mono text-xs font-medium text-on-accent transition-opacity hover:opacity-90">
              Run report <Icon name="lucide:arrow-right" class="size-3" aria-hidden="true" />
            </a>
          </div>
          <div class="mt-3 overflow-x-auto rounded border border-hairline bg-raised">
            <table class="data">
              <thead>
                <tr>
                  <th>Character</th>
                  <th>Model</th>
                  <th>Harness</th>
                  <th>Class</th>
                  <th>Outcome</th>
                  <th class="num">Time</th>
                  <th class="num">Level</th>
                  <th class="num">Deaths</th>
                  <th class="num">Cost</th>
                </tr>
              </thead>
              <tbody>
                {r.players
                  .toSorted((a, b) => Number(b.met) - Number(a.met) || (a.time_to_goal_s ?? Infinity) - (b.time_to_goal_s ?? Infinity))
                  .map(p => (
                    <tr>
                      <td class="text-fg">{p.char}</td>
                      <td class="text-fg">{modelName(p.model)}</td>
                      <td class="text-muted">{harnessName(p.runtime)}</td>
                      <td class="text-muted capitalize">{p.spec ? `${p.spec} ` : ''}{p.class}</td>
                      <td class:list={[p.met ? 'text-success' : 'text-warning']} title={p.gave_up}>{outcome(p)}</td>
                      <td class="num">{p.met ? duration(p.time_to_goal_s) : '–'}</td>
                      <td class="num text-muted">{p.level ?? '–'}</td>
                      <td class="num text-muted">{p.deaths ?? '–'}</td>
                      <td class="num text-muted">{dollars(p.cost_usd)}</td>
                    </tr>
                  ))}
              </tbody>
            </table>
          </div>
        </article>
      ))}
    </div>
  </Section>
</Layout>
