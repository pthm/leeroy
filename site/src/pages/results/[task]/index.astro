---
// A task at the latest version it was run in.
import TaskPage from '../../../components/pages/TaskPage.astro';
import { latestFor, tasks } from '../../../lib/results';

export function getStaticPaths() {
  return tasks().map(task => ({ params: { task } }));
}

const { task } = Astro.params;
---

<TaskPage task={task} version={latestFor(task)} />
