---
import CostChart from '../../components/CostChart.astro';
import Leaderboard from '../../components/Leaderboard.astro';
import Section from '../../components/Section.astro';
import SectionHeader from '../../components/SectionHeader.astro';
import Layout from '../../layouts/Layout.astro';
import { TASKS, dollars, duration, harnessName, modelName, runDate, runsOf, taskTitle, tasks } from '../../lib/results';

export function getStaticPaths() {
  return tasks().map(task => ({ params: { task } }));
}

const { task } = Astro.params;
const info = TASKS[task];
const runs = runsOf(task).toReversed();
const outcome = (p: (typeof runs)[number]['players'][number]) =>
  p.met ? 'met' : p.gave_up ? 'gave up' : p.died ? 'died' : 'not met';
---

<Layout title={taskTitle(task)} description={info?.summary}>
  <Section>
    <SectionHeader eyebrow="Results" title={taskTitle(task)} description={info?.summary} level={1} />
    {info && <p class="-mt-6 mb-10 max-w-xl font-mono text-xs text-faint">Scoring: {info.scoring}</p>}
    <Leaderboard task={task} />
    <div class="mt-8">
      <CostChart task={task} />
    </div>
  </Section>

  <Section last>
    <SectionHeader eyebrow="Runs" title="Run by run." description="Newest first. Every player in every run, as the judge left them." />
    <div class="space-y-12">
      {runs.map(r => (
        <article id={r.id}>
          <h3 class="font-mono text-sm text-fg">
            <a href={`#${r.id}`} class="hover:text-accent">{runDate(r)}</a>
            <span class="text-faint"> · {r.scenario} · {r.minutes >= 1440 ? `${r.minutes / 1440} days` : `${r.minutes} min`} on the clock</span>
          </h3>
          <div class="mt-3 overflow-x-auto rounded border border-hairline bg-raised">
            <table class="data">
              <thead>
                <tr>
                  <th>Character</th>
                  <th>Model</th>
                  <th>Harness</th>
                  <th>Class</th>
                  <th>Outcome</th>
                  <th class="num">Time</th>
                  <th class="num">Level</th>
                  <th class="num">Deaths</th>
                  <th class="num">Cost</th>
                </tr>
              </thead>
              <tbody>
                {r.players
                  .toSorted((a, b) => Number(b.met) - Number(a.met) || (a.time_to_goal_s ?? Infinity) - (b.time_to_goal_s ?? Infinity))
                  .map(p => (
                    <tr>
                      <td class="text-fg">{p.char}</td>
                      <td class="text-fg">{modelName(p.model)}</td>
                      <td class="text-muted">{harnessName(p.runtime)}</td>
                      <td class="text-muted capitalize">{p.spec ? `${p.spec} ` : ''}{p.class}</td>
                      <td class:list={[p.met ? 'text-success' : 'text-warning']} title={p.gave_up}>{outcome(p)}</td>
                      <td class="num">{p.met ? duration(p.time_to_goal_s) : '–'}</td>
                      <td class="num text-muted">{p.level ?? '–'}</td>
                      <td class="num text-muted">{p.deaths ?? '–'}</td>
                      <td class="num text-muted">{dollars(p.cost_usd)}</td>
                    </tr>
                  ))}
              </tbody>
            </table>
          </div>
        </article>
      ))}
    </div>
  </Section>
</Layout>
