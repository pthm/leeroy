---
import { getCollection } from 'astro:content';
import Section from '../../components/Section.astro';
import SectionHeader from '../../components/SectionHeader.astro';
import Layout from '../../layouts/Layout.astro';
import { postDate } from '../../lib/posts';
import { asset, url } from '../../lib/url';

// The latest post as a feature, its image beside it; the earlier ones below as cards, like the homepage's.
const [latest, ...earlier] = (await getCollection('blog')).toSorted((a, b) => +b.data.date - +a.data.date);
---

<Layout title="Blog" description="Stories from LEEROY runs and how the benchmark is built.">
  <Section last>
    <SectionHeader eyebrow="Blog" title="From the project" description="Stories from individual runs, how the benchmark and its tools are built, and what we changed along the way." level={1} />
    {latest && (
      <a href={url(`/blog/${latest.id}`)} class="group grid overflow-hidden rounded border border-hairline bg-raised transition-colors hover:border-outline md:grid-cols-[3fr_2fr]">
        {latest.data.image && (
          <img src={asset(latest.data.image)} alt="" class="aspect-[16/10] h-full w-full border-b border-hairline object-cover md:border-r md:border-b-0" />
        )}
        <div class="flex flex-col justify-center p-6 sm:p-8">
          <p class="eyebrow">Latest</p>
          <time datetime={latest.data.date.toISOString()} class="mt-3 font-mono text-xs text-faint">{postDate(latest.data.date)}</time>
          <h2 class="mt-2 font-serif text-3xl leading-tight text-fg group-hover:text-accent">{latest.data.title}</h2>
          <p class="mt-3 text-base text-muted">{latest.data.description}</p>
          <span class="mt-5 font-mono text-xs text-accent">Read the post →</span>
        </div>
      </a>
    )}
    {earlier.length > 0 && (
      <>
        <h2 class="eyebrow mt-14">Earlier posts</h2>
        <ul class="mt-4 grid grid-cols-1 gap-4 md:grid-cols-3">
          {earlier.map(p => (
            <li class="overflow-hidden rounded border border-hairline bg-raised transition-colors hover:border-outline">
              <a href={url(`/blog/${p.id}`)} class="group block">
                {p.data.image && <img src={asset(p.data.image)} alt="" class="aspect-[16/10] w-full border-b border-hairline object-cover" loading="lazy" />}
                <div class="p-5">
                  <time datetime={p.data.date.toISOString()} class="font-mono text-[11px] text-faint">{postDate(p.data.date)}</time>
                  <h3 class="mt-2 font-serif text-xl text-fg group-hover:text-accent">{p.data.title}</h3>
                  <p class="mt-2 text-sm text-muted">{p.data.description}</p>
                </div>
              </a>
            </li>
          ))}
        </ul>
      </>
    )}
  </Section>
</Layout>
