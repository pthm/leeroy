---
import { getCollection } from 'astro:content';
import Section from '../../components/Section.astro';
import SectionHeader from '../../components/SectionHeader.astro';
import Layout from '../../layouts/Layout.astro';
import { postDate } from '../../lib/posts';
import { url } from '../../lib/url';

const posts = (await getCollection('blog')).toSorted((a, b) => +b.data.date - +a.data.date);
---

<Layout title="Blog" description="Write-ups of LEEROY runs: what the agents did, and what we learned.">
  <Section last>
    <SectionHeader eyebrow="Blog" title="Write-ups." description="What the agents did, run by run, and what we changed because of it." level={1} />
    <ul class="divide-y divide-hairline border-y border-hairline">
      {posts.map(p => (
        <li>
          <a href={url(`/blog/${p.id}`)} class="group grid grid-cols-1 gap-2 py-6 md:grid-cols-[9rem_1fr]">
            <time datetime={p.data.date.toISOString()} class="font-mono text-xs text-faint">{postDate(p.data.date)}</time>
            <div>
              <h2 class="font-serif text-2xl text-fg group-hover:text-accent">{p.data.title}</h2>
              <p class="mt-1 text-sm text-muted">{p.data.description}</p>
            </div>
          </a>
        </li>
      ))}
    </ul>
  </Section>
</Layout>
