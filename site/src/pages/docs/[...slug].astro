---
import { getCollection, render } from 'astro:content';
import Section from '../../components/Section.astro';
import Layout from '../../layouts/Layout.astro';
import { url } from '../../lib/url';

// /docs is the first page; the rest are /docs/<id>.
export async function getStaticPaths() {
  const docs = (await getCollection('docs')).toSorted((a, b) => a.data.order - b.data.order);
  return docs.map((doc, i) => ({ params: { slug: i === 0 ? undefined : doc.id }, props: { doc, docs } }));
}

const { doc, docs } = Astro.props;
const { Content } = await render(doc);
const href = (i: number) => url(i === 0 ? '/docs' : `/docs/${docs[i].id}`);
const at = docs.findIndex(d => d.id === doc.id);
---

<Layout title={doc.data.title} description={doc.data.description}>
  <Section last>
    <div class="grid grid-cols-1 gap-10 md:grid-cols-[12rem_1fr]">
      <nav aria-label="Docs">
        <p class="eyebrow mb-4">Docs</p>
        <ul class="space-y-2 font-mono text-xs">
          {docs.map((d, i) => (
            <li>
              <a href={href(i)} aria-current={i === at ? 'page' : undefined} class:list={[i === at ? 'text-accent' : 'text-muted hover:text-fg']}>
                {d.data.title}
              </a>
            </li>
          ))}
        </ul>
      </nav>
      <article class="min-w-0 max-w-2xl">
        <h1 class="font-serif text-4xl text-fg">{doc.data.title}</h1>
        <p class="mt-3 text-base text-muted">{doc.data.description}</p>
        <div class="prose mt-8">
          <Content />
        </div>
        {at + 1 < docs.length && (
          <a href={href(at + 1)} class="mt-12 inline-block font-mono text-xs text-accent hover:underline">Next: {docs[at + 1].data.title} →</a>
        )}
      </article>
    </div>
  </Section>
</Layout>
